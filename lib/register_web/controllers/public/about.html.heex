<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title suffix=" · Phoenix Framework">
      About - E-Register
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="h-full bg-gray-50">
    <.flash_group flash={@flash} />
    
    <!-- Navigation -->
    <nav class="bg-white shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="text-2xl font-bold text-blue-600">E-Register</a>
          </div>
          <div class="flex items-center space-x-8">
            <a href="/" class="text-gray-700 hover:text-blue-600 px-3 py-2 text-sm font-medium">Home</a>
            <a href="/about" class="text-blue-600 px-3 py-2 text-sm font-medium border-b-2 border-blue-600">About</a>
            <%= if assigns[:current_user] do %>
              <a href="/Admin/dashboard" class="text-gray-700 hover:text-blue-600 px-3 py-2 text-sm font-medium">Dashboard</a>
              <a href="/users/log_out" data-method="delete" class="bg-red-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-red-700">Log out</a>
            <% else %>
              <a href="/users/login" class="text-gray-700 hover:text-blue-600 px-3 py-2 text-sm font-medium">Login</a>
              <a href="/users/register" class="bg-blue-600 text-white px-4 py-2 rounded-md text-sm font-medium hover:bg-blue-700">Register</a>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <div class="min-h-full flex flex-col justify-center py-12 sm:px-6 lg:px-8">
      <div class="sm:mx-auto sm:w-full sm:max-w-4xl">
        <div class="bg-white py-8 px-4 shadow sm:rounded-lg sm:px-10">
          <div class="max-w-3xl mx-auto">
            <h1 class="text-3xl font-bold text-gray-900 mb-8">About E-Register</h1>
            
            <div class="prose prose-lg text-gray-700 space-y-6">
              <p>
                E-Register is a modern, secure digital registration and management system built with Phoenix LiveView and Elixir. 
                Our platform provides a comprehensive solution for managing user registrations, authentication, and administrative tasks.
              </p>

              <h2 class="text-2xl font-semibold text-gray-900 mt-8 mb-4">Key Features</h2>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
                <div class="bg-blue-50 p-6 rounded-lg">
                  <h3 class="text-lg font-semibold text-blue-900 mb-2">Secure Authentication</h3>
                  <p class="text-blue-800">
                    Industry-standard security with encrypted passwords, session management, and email verification.
                  </p>
                </div>
                
                <div class="bg-green-50 p-6 rounded-lg">
                  <h3 class="text-lg font-semibold text-green-900 mb-2">Real-time Dashboard</h3>
                  <p class="text-green-800">
                    Live updates and interactive dashboard powered by Phoenix LiveView for seamless user experience.
                  </p>
                </div>
                
                <div class="bg-purple-50 p-6 rounded-lg">
                  <h3 class="text-lg font-semibold text-purple-900 mb-2">User Management</h3>
                  <p class="text-purple-800">
                    Comprehensive user profile management with settings, preferences, and account controls.
                  </p>
                </div>
                
                <div class="bg-orange-50 p-6 rounded-lg">
                  <h3 class="text-lg font-semibold text-orange-900 mb-2">Scalable Architecture</h3>
                  <p class="text-orange-800">
                    Built on Elixir/Phoenix for high performance, fault tolerance, and easy scaling.
                  </p>
                </div>
              </div>

              <h2 class="text-2xl font-semibold text-gray-900 mt-8 mb-4">Technology Stack</h2>
              
              <div class="bg-gray-50 p-6 rounded-lg">
                <ul class="grid grid-cols-2 gap-4 text-sm">
                  <li class="flex items-center">
                    <span class="w-2 h-2 bg-purple-500 rounded-full mr-3"></span>
                    <strong>Elixir</strong> - Functional programming language
                  </li>
                  <li class="flex items-center">
                    <span class="w-2 h-2 bg-orange-500 rounded-full mr-3"></span>
                    <strong>Phoenix</strong> - Web framework
                  </li>
                  <li class="flex items-center">
                    <span class="w-2 h-2 bg-blue-500 rounded-full mr-3"></span>
                    <strong>LiveView</strong> - Real-time web interfaces
                  </li>
                  <li class="flex items-center">
                    <span class="w-2 h-2 bg-green-500 rounded-full mr-3"></span>
                    <strong>PostgreSQL</strong> - Database
                  </li>
                  <li class="flex items-center">
                    <span class="w-2 h-2 bg-cyan-500 rounded-full mr-3"></span>
                    <strong>Tailwind CSS</strong> - Styling
                  </li>
                  <li class="flex items-center">
                    <span class="w-2 h-2 bg-red-500 rounded-full mr-3"></span>
                    <strong>Alpine.js</strong> - JavaScript framework
                  </li>
                </ul>
              </div>

              <h2 class="text-2xl font-semibold text-gray-900 mt-8 mb-4">Getting Started</h2>
              
              <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                <ol class="list-decimal list-inside space-y-2 text-blue-800">
                  <li><strong>Create an account</strong> by clicking the Register button</li>
                  <li><strong>Verify your email</strong> (if email verification is enabled)</li>
                  <li><strong>Access your dashboard</strong> to manage your profile and settings</li>
                  <li><strong>Explore features</strong> as they become available</li>
                </ol>
              </div>

              <div class="mt-8 text-center">
                <div class="inline-flex space-x-4">
                  <a href="/" class="bg-gray-600 text-white px-6 py-3 rounded-md font-medium hover:bg-gray-700 transition-colors">
                    Back to Home
                  </a>
                  <%= if assigns[:current_user] do %>
                    <a href="/Admin/dashboard" class="bg-blue-600 text-white px-6 py-3 rounded-md font-medium hover:bg-blue-700 transition-colors">
                      Go to Dashboard
                    </a>
                  <% else %>
                    <a href="/users/register" class="bg-blue-600 text-white px-6 py-3 rounded-md font-medium hover:bg-blue-700 transition-colors">
                      Get Started
                    </a>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
