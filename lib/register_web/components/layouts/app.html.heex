<div class="min-h-screen bg-gray-50 flex flex-col" id="app-layout">
  <!-- Navigation -->
  <nav class="bg-white shadow-sm fixed top-0 left-0 right-0 z-50">
    <div class="max-w-full sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <button
            phx-click="toggle_sidebar"
            class="mr-4 p-2 rounded-md text-gray-400 hover:text-gray-500 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-blue-500 lg:hidden"
            phx-target="#app-layout"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
          <a href="/" class="text-2xl font-bold text-blue-600">E-Register</a>
        </div>
        <div class="flex items-center space-x-8">
          <%= if Map.get(assigns, :current_user) do %>
            <.link
              href={~p"/Admin/users/settings"}
              class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors"
            >
              Settings
            </.link>
            <.link
              href={~p"/users/log_out"}
              method="delete"
              class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors"
            >``
              Log out
            </.link>
          <% end %>
        </div>
      </div>
    </div>
  </nav>

  <div class="flex flex-1 pt-16">
    <!-- Sidebar (only show when user is logged in) -->
    <%= if @current_user do %>
      <div class={[
        "fixed inset-y-0 left-0 z-30 w-64 transform transition-transform duration-300 ease-in-out bg-white shadow-lg md:translate-x-0",
        if(assigns[:sidebar_open] || false, do: "translate-x-0", else: "-translate-x-full")
      ]}>
        <.sidebar 
          sidebar_open={assigns[:sidebar_open] || false} 
          current_path={assigns[:current_path] || ""}
          user_type={@current_user.role |> String.to_atom()}
        />
      </div>

      <!-- Sidebar overlay for mobile -->
      <div 
        class={[
          "fixed inset-0 z-20 bg-black bg-opacity-50 transition-opacity duration-300 ease-in-out md:hidden",
          if(assigns[:sidebar_open] || false, do: "opacity-100", else: "opacity-0 pointer-events-none")
        ]}
        phx-click="toggle_sidebar"
        phx-target="#app-layout">
      </div>
    <% end %>

    <!-- Main Content -->
    <main class={[
      "flex-1 transition-all duration-300 ease-in-out",
      "ml-0 md:ml-64"
    ]}>
      <div class="px-4 sm:px-6 lg:px-8 py-6">
        <!-- Flash messages -->
        <.flash_group flash={@flash} />

        <!-- Page content -->
        <div class="py-4">
          <%= @inner_content %>
        </div>
      </div>
    </main>
  </div>
</div>
