<div class="p-6">
  <h1 class="text-2xl font-semibold mb-4">Generate OTP for Class Attendance</h1>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="bg-white border rounded p-4">
      <h2 class="text-lg font-semibold mb-4">Create OTP</h2>

      <form phx-submit="generate" class="space-y-5">
        <div>
          <label for="course_id" class="block text-sm font-medium text-gray-700">Select Course</label>
          <div class="mt-1">
            <select
              id="course_id"
              name="form[course_id]"
              required
              class="block w-full rounded-md border-gray-300 py-2 pl-3 pr-10 text-sm focus:border-blue-500 focus:outline-none focus:ring-blue-500"
            >
              <option value="">-- Select a course --</option>
              <%= for course <- @courses do %>
                <option value={course.id}><%= course.title %> (<%= course.code %>)</option>
              <% end %>
            </select>
          </div>
        </div>

        <div>
          <label for="location" class="block text-sm font-medium text-gray-700">Location (optional)</label>
          <input
            type="text"
            name="form[location]"
            id="location"
            class="mt-1 block w-full rounded-md border-gray-300 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500"
            placeholder="e.g., Room 101"
          />
        </div>

        <div>
          <label for="expires_in" class="block text-sm font-medium text-gray-700">Expires after (minutes)</label>
          <input
            type="number"
            name="form[expires_in]"
            id="expires_in"
            value="30"
            min="5"
            max="1440"
            class="mt-1 block w-28 rounded-md border-gray-300 text-sm shadow-sm focus:border-blue-500 focus:ring-blue-500"
          />
        </div>

        <div class="flex justify-end">
          <button
            type="submit"
          class="text-white bg-gradient-to-r from-cyan-500 to-blue-500 hover:bg-gradient-to-bl focus:ring-4 focus:outline-none focus:ring-cyan-300 dark:focus:ring-cyan-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2"                      phx-click="view_otp" 
          >
            Generate OTP
          </button>
        </div>
      </form>
    </div>

    <div class="bg-white border rounded p-4">
      <h2 class="text-lg font-semibold mb-4">Current OTP</h2>

      <%= if current_otp = @selected_otp || @otp do %>
        <div class="space-y-4">
          <div class="rounded border border-blue-100 bg-blue-50 p-4">
            <p class="text-sm font-medium text-blue-600">Verification Code</p>
            <p class="mt-2 text-center font-mono text-3xl font-bold text-blue-800">
              <%= current_otp.code %>
            </p>
          </div>

          <div class="rounded border border-gray-200 bg-gray-50 p-4">
            <p class="text-sm font-medium text-gray-600">For Module</p>
            <p class="mt-2 text-center text-xl font-medium">
              <%= current_otp.module_code %>
            </p>
          </div>

          <p class="text-center text-sm text-gray-500">
            Expires at: <%= Timex.format!(current_otp.expires_at, "{h12}:{m} {AM}") %>
          </p>
        </div>
      <% else %>
        <div class="rounded border border-dashed border-gray-300 p-6 text-center text-sm text-gray-500">
          Generate an OTP to preview it here.
        </div>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
    <h2 class="text-lg font-semibold mb-4">Recent OTPs</h2>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="border-b font-medium">
          <tr>
            <th class="px-3 py-2">Code</th>
            <th class="px-3 py-2">Module</th>
            <th class="px-3 py-2">Location</th>
            <th class="px-3 py-2">Expires</th>
            <th class="px-3 py-2">Active</th>
            <th class="px-3 py-2 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          <%= if Enum.empty?(@otps) do %>
            <tr>
              <td colspan="6" class="px-3 py-4 text-center text-sm text-gray-500">
                Generate an OTP to see it listed here.
              </td>
            </tr>
          <% else %>
            <%= for otp <- @otps do %>
              <tr class={if @selected_otp && @selected_otp.id == otp.id, do: "bg-blue-50"}>
                <td class="px-3 py-2 font-mono"><%= otp.code %></td>
                <td class="px-3 py-2"><%= otp.module_code %></td>
                <td class="px-3 py-2"><%= otp.location %></td>
                <td class="px-3 py-2"><%= Timex.format!(otp.expires_at, "{YYYY}-{0M}-{0D} {h12}:{m} {AM}") %></td>
                <td class="px-3 py-2"><%= if otp.is_active, do: "Yes", else: "No" %></td>
                <td class="px-3 py-2">
                  <div class="flex justify-end gap-2">
                    <button 
                      class="text-white bg-gradient-to-r from-cyan-500 to-blue-500 hover:bg-gradient-to-bl focus:ring-4 focus:outline-none focus:ring-cyan-300 dark:focus:ring-cyan-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2"                      phx-click="view_otp" 
                      phx-value-id={otp.id}
                      >
                      View
                    </button>
                    <button 
                      class="text-white bg-gradient-to-br from-red-400 to-blue-600 hover:bg-gradient-to-bl focus:ring-4 focus:outline-none focus:ring-cyan-200 dark:focus:ring-cyan-800 font-medium rounded-lg text-sm px-5 py-2.5 text-center me-2 mb-2"
                      phx-click="delete_otp" 
                      phx-value-id={otp.id}
                      data-confirm="Are you sure you want to delete this OTP?"
                      >
                      Delete
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
