<div class="w-full bg-gray-50">
  <div class="p-6">
    <div class="mb-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-800">My Teaching Overview</h2>
        <div class="bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-sm font-medium">
          Lecturer Dashboard
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-blue-500 to-blue-600 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-blue-100 text-sm font-medium">Total Students</p>
                <h3 class="text-2xl font-bold text-white"><%= @total_students %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-blue-50">
            <div class="flex items-center justify-between">
              <span class="text-blue-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
                Active
              </span>
              <span class="text-gray-500 text-xs">enrolled</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-purple-500 to-purple-600 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-purple-100 text-sm font-medium">My Courses</p>
                <h3 class="text-2xl font-bold text-white"><%= length(@courses) %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-purple-50">
            <div class="flex items-center justify-between">
              <span class="text-purple-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Active
              </span>
              <span class="text-gray-500 text-xs">this semester</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-green-500 to-green-600 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-green-100 text-sm font-medium">Total Attendance</p>
                <h3 class="text-2xl font-bold text-white"><%= @attendance_summary.total_attendance || 0 %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-green-50">
            <div class="flex items-center justify-between">
              <span class="text-green-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
                Tracking
              </span>
              <span class="text-gray-500 text-xs">all time</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-orange-500 to-orange-600 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-orange-100 text-sm font-medium">Unique Students</p>
                <h3 class="text-2xl font-bold text-white"><%= @attendance_summary.unique_students || 0 %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-orange-50">
            <div class="flex items-center justify-between">
              <span class="text-orange-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                Engaged
              </span>
              <span class="text-gray-500 text-xs">across courses</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-800">System Performance</h2>
        <div class="flex items-center space-x-2">
          <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
          <span class="text-sm text-gray-600">Live monitoring</span>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-4">
          <div class="flex items-center justify-between mb-2">
            <p class="text-gray-600 text-sm font-medium">Uptime</p>
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800"><%= @uptime_min %> min</h3>
        </div>
        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-4">
          <div class="flex items-center justify-between mb-2">
            <p class="text-gray-600 text-sm font-medium">Memory</p>
            <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800"><%= @memory_mb %> MB</h3>
        </div>
        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-4">
          <div class="flex items-center justify-between mb-2">
            <p class="text-gray-600 text-sm font-medium">Run Queue</p>
            <svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800"><%= @run_queue %></h3>
        </div>
        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-4">
          <div class="flex items-center justify-between mb-2">
            <p class="text-gray-600 text-sm font-medium">IO In</p>
            <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800"><%= @io_in_kbs %> KB/s</h3>
        </div>
        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-4">
          <div class="flex items-center justify-between mb-2">
            <p class="text-gray-600 text-sm font-medium">IO Out</p>
            <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8V4m0 0l-4 4m4-4l4 4M7 20v-4m0 0l-4 4m4-4l4 4"></path>
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-800"><%= @io_out_kbs %> KB/s</h3>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
      <div class="bg-white rounded-lg shadow p-6 lg:col-span-2">
        <div class="flex justify-between items-center mb-4">
          <h2 class="text-lg font-semibold text-gray-800">Course Attendance Overview</h2>
          <div class="flex space-x-2">
            <button class="px-3 py-1 text-xs bg-blue-100 text-blue-800 rounded-md">Week</button>
            <button class="px-3 py-1 text-xs bg-gray-100 text-gray-800 rounded-md">Month</button>
            <button class="px-3 py-1 text-xs bg-gray-100 text-gray-800 rounded-md">Semester</button>
          </div>
        </div>
        <canvas id="dailySigninsChart" height="250"></canvas>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Attendance Methods</h2>
        <canvas id="signinDistributionChart" height="250"></canvas>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Memory Usage (MB)</h2>
        <canvas id="systemMemChart" height="220"></canvas>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Run Queue</h2>
        <canvas id="systemRunqChart" height="220"></canvas>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">IO Throughput (KB/s)</h2>
        <canvas id="systemIOChart" height="220"></canvas>
      </div>
    </div>

    <div id="system-metrics-data" phx-hook="SystemCharts" data-labels={Jason.encode!(@labels)} data-mem-series={Jason.encode!(@mem_series)} data-runq-series={Jason.encode!(@runq_series)} data-ioin-series={Jason.encode!(@ioin_series)} data-ioout-series={Jason.encode!(@ioout_series)} class="hidden">
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
      <div class="bg-white rounded-lg shadow p-6 lg:col-span-2">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Attendance by Course</h2>
        <canvas id="progBarChart" height="260"></canvas>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">7-Day Attendance Trend</h2>
        <canvas id="usersLineChart" height="260"></canvas>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">OTP Status</h2>
        <canvas id="otpDonutChart" height="240"></canvas>
      </div>
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">QR Codes Status</h2>
        <canvas id="qrDonutChart" height="240"></canvas>
      </div>
    </div>

    <div id="stats-data" phx-hook="StatsCharts" data-prog-labels={Jason.encode!(@course_labels || [])} data-prog-counts={Jason.encode!(@course_counts || [])} data-users-labels={Jason.encode!(@attendance_labels || [])} data-users-counts={Jason.encode!(@attendance_counts || [])} data-otps-active={@otp_active || 0} data-otps-inactive={@otp_inactive || 0} data-qr-active={@qr_active || 0} data-qr-expired={@qr_inactive || 0} class="hidden">
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">My Courses</h2>
        <div class="space-y-4">
          <%= for course <- Enum.take(@courses, 4) do %>
          <div class="flex items-center justify-between p-3 bg-blue-50 rounded-lg">
            <div>
              <h4 class="font-medium"><%= course.title %></h4>
              <p class="text-sm text-gray-500"><%= course.code %> | <%= course.credits %> credits</p>
            </div>
            <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">Active</span>
          </div>
          <% end %>
        </div>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Weekly Attendance Trend</h2>
        <canvas id="weeklyTrendChart" height="250"></canvas>
      </div>

      <div class="bg-white rounded-lg shadow p-6">
        <h2 class="text-lg font-semibold text-gray-800 mb-4">Recent Attendance</h2>
        <div class="space-y-3">
          <%= for session <- Enum.take(@attendance_summary.sessions || [], 5) do %>
          <div class="flex items-center space-x-3 p-2 hover:bg-gray-50 rounded-lg">
            <div class="bg-blue-100 p-2 rounded-full">
              <i class="fas fa-user-check text-blue-600 text-sm"></i>
            </div>
            <div>
              <h4 class="font-medium"><%= session.student_name %></h4>
              <p class="text-sm text-gray-500"><%= session.course.title %> | <%= session.module_code %></p>
            </div>
            <div class="ml-auto text-right">
              <span class="text-xs text-gray-500"><%= Calendar.strftime(session.inserted_at, "%H:%M") %></span>
              <div class="text-xs mt-1">
                <%= if session.type == "qr" do %>
                <span class="bg-green-100 text-green-800 px-1 rounded">QR</span>
                <% else %>
                <span class="bg-blue-100 text-blue-800 px-1 rounded">OTP</span>
                <% end %>
              </div>
            </div>
          </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Daily Sign-ins Chart (Course Attendance)
  const dailySigninsCtx = document.getElementById('dailySigninsChart').getContext('2d');
  const dailySigninsChart = new Chart(dailySigninsCtx, {
    type: 'line',
    data: {
      labels: ['6:00 AM', '8:00 AM', '10:00 AM', '12:00 PM', '2:00 PM', '4:00 PM'],
      datasets: [{
          label: 'QR Attendance',
          data: [45, 52, 38, 65, 48, 25],
          borderColor: '#3B82F6',
          backgroundColor: 'rgba(59, 130, 246, 0.1)',
          tension: 0.3,
          fill: true
        },
        {
          label: 'OTP Attendance',
          data: [28, 35, 42, 38, 45, 15],
          borderColor: '#8B5CF6',
          backgroundColor: 'rgba(139, 92, 246, 0.1)',
          tension: 0.3,
          fill: true
        }
      ]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'top',
        },
        tooltip: {
          mode: 'index',
          intersect: false,
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: function(value) {
              return value + ' students';
            }
          }
        }
      }
    }
  });

  // Sign-in Distribution Chart (Attendance Methods)
  const signinDistributionCtx = document.getElementById('signinDistributionChart').getContext('2d');
  const signinDistributionChart = new Chart(signinDistributionCtx, {
    type: 'doughnut',
    data: {
      labels: ['QR Code', 'OTP'],
      datasets: [{
        data: [65, 35],
        backgroundColor: [
          '#3B82F6',
          '#8B5CF6'
        ],
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'bottom',
        },
        tooltip: {
          callbacks: {
            label: function(context) {
              const label = context.label || '';
              const value = context.raw || 0;
              const total = context.dataset.data.reduce((a, b) => a + b, 0);
              const percentage = Math.round((value / total) * 100);
              return `${label}: ${value}%`;
            }
          }
        }
      }
    }
  });

  // Weekly Trend Chart
  const weeklyTrendCtx = document.getElementById('weeklyTrendChart').getContext('2d');
  const weeklyTrendChart = new Chart(weeklyTrendCtx, {
    type: 'bar',
    data: {
      labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
      datasets: [{
        label: 'Attendance',
        data: [35, 42, 38, 45, 50, 15],
        backgroundColor: '#10B981',
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'top',
        },
        tooltip: {
          mode: 'index',
          intersect: false,
        }
      },
      scales: {
        x: {
          stacked: false,
        },
        y: {
          stacked: false,
          beginAtZero: true
        }
      }
    }
  });
</script>