<div class="p-6">
  <h1 class="text-2xl font-semibold mb-4">Attendance View</h1>

  <%= if @current_user do %>
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
      <!-- Filters Panel -->
      <div class="bg-white border rounded p-4 lg:col-span-1">
        <h2 class="text-lg font-semibold mb-3">Filters</h2>

        <div class="space-y-4">
          <form phx-change="select_program">
            <label class="block text-sm font-medium text-gray-700 mb-1">Program</label>
            <select name="program_id" class="w-full border rounded px-3 py-2">
              <option value="">All Programs</option>
              <%= for program <- @programs do %>
                <option value={program.id} selected={@selected_program_id == program.id}>
                  <%= program.name %>
                </option>
              <% end %>
            </select>
          </form>

          <%= if @courses != [] do %>
            <form phx-change="select_course">
              <label class="block text-sm font-medium text-gray-700 mb-1">Course / Module</label>
              <select name="course_id" class="w-full border rounded px-3 py-2">
                <option value="">All Courses</option>
                <%= for course <- @courses do %>
                  <option value={course.id} selected={@selected_course_id == course.id}>
                    <%= course.title %> (<%= course.code %>)
                  </option>
                <% end %>
              </select>
            </form>
          <% end %>
        </div>
      </div>

      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Summary Cards -->
        <div class="bg-white border rounded p-4">
          <h2 class="text-lg font-semibold mb-3">Summary</h2>
          
          <%= if @summary do %>
            <%= if @current_module_stats && map_size(@current_module_stats) > 0 do %>
              <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="p-3 border rounded">
                  <div class="text-xs text-gray-500">Total Sessions</div>
                  <div class="text-xl font-semibold"><%= @current_module_stats[:total_sessions] || 0 %></div>
                </div>
                <div class="p-3 border rounded">
                  <div class="text-xs text-gray-500">Unique Students</div>
                  <div class="text-xl font-semibold"><%= @current_module_stats[:unique_students] || 0 %></div>
                </div>
                <div class="p-3 border rounded">
                  <div class="text-xs text-gray-500">Total Attendance</div>
                  <div class="text-xl font-semibold text-green-700">
                    <%= @current_module_stats[:total_attendance] || 0 %>
                  </div>
                  <div class="text-xs text-gray-500 mt-1">
                    <span class="text-blue-600">QR: <%= @current_module_stats[:qr_attendance] || 0 %></span> • 
                    <span class="text-green-600">OTP: <%= @current_module_stats[:otp_attendance] || 0 %></span>
                  </div>
                </div>
                <div class="p-3 border rounded">
                  <div class="text-xs text-gray-500">Avg. Attendance</div>
                  <div class="text-xl font-semibold">
                    <%= if @current_module_stats[:total_sessions] && @current_module_stats[:total_sessions] > 0 do %>
                      <%= Float.round(
                        (@current_module_stats[:total_attendance] || 0) /
                        (@current_module_stats[:unique_students] * @current_module_stats[:total_sessions]) * 100, 1
                      ) %>%
                    <% else %>
                      -
                    <% end %>
                  </div>
                </div>
              </div>
            <% else %>
              <div class="text-gray-600">No statistics available. Please select a program and course.</div>
            <% end %>
          <% else %>
            <div class="text-gray-600">Select a program and optionally a course to view attendance summary.</div>
          <% end %>
        </div>

        <!-- Recent Scans -->
        <div class="bg-white border rounded p-4">
          <h2 class="text-lg font-semibold mb-3">Recent Scans</h2>
          
          <%= if @summary && !Enum.empty?(@summary.sessions) do %>
            <div class="space-y-2">
              <%= for session <- Enum.take(@summary.sessions, 5) do %>
                <div class="flex justify-between items-center py-2 border-b">
                  <div class="text-gray-700">
                    <div class="font-medium"><%= session.module_code %> - <%= session.title %></div>
                    <div class="text-xs text-gray-500">
                      <%= Calendar.strftime(session.inserted_at, "%b %d, %Y %H:%M") %> • 
                      <span class={if session.type == :qr, do: "text-blue-600", else: "text-green-600"}>
                        <%= String.upcase(to_string(session.type)) %>
                      </span>
                    </div>
                  </div>
                  <span class="text-sm font-medium text-gray-700">
                    <%= session.student_name %>
                  </span>
                </div>
              <% end %>
            </div>
            
            <%= if @summary.total_scans > 5 do %>
              <div class="text-center mt-3">
                <button class="text-blue-600 hover:text-blue-800 text-sm font-medium">
                  View all scans
                </button>
              </div>
            <% end %>
          <% else %>
            <div class="text-gray-600">No scans recorded yet.</div>
          <% end %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="text-red-600">You must be logged in to view this page.</div>
  <% end %>
</div>
