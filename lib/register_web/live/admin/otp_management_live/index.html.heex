<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-2xl font-semibold text-gray-900">OTP Management</h1>
      <p class="mt-2 text-sm text-gray-700">Manage one-time passwords for your application.</p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <.link
        patch={~p"/Admin/otp-management/new"}
        class="inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-4 py-2 text-sm font-medium text-white shadow-sm hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 sm:w-auto"
      >
        Generate OTP
      </.link>
    </div>
  </div>

  <!-- OTPs Table -->
  <div class="mt-8 flex flex-col">
    <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Code</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Purpose</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Status</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Expires</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Created By</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <%= if Enum.empty?(@otps) do %>
                <tr>
                  <td colspan="6" class="px-6 py-4 text-center text-sm text-gray-500">
                    No OTPs found. Generate a new OTP to get started.
                    <div class="mt-2 text-xs text-gray-400">
                      Debug: connected? = <%= connected?(@socket) %>, count = <%= length(@otps) %>
                    </div>
                  </td>
                </tr>
              <% else %>
                <%= for otp <- @otps do %>
                  <tr class="hover:bg-gray-50" id={"otp-#{otp.id}"}>
                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-mono font-medium text-gray-900 sm:pl-6">
                      <%= otp.code %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <%= String.capitalize(otp.purpose || "N/A") %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <%= raw otp_status(otp) %>
                      <p class="text-xs text-gray-400 mt-1"><%= time_remaining(otp.expires_at) %></p>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <%= format_expiration(otp.expires_at) %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <%= otp.created_by.email %>
                    </td>
                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                      <div class="relative inline-block text-left" id={"dropdown-#{otp.id}"} phx-hook="Dropdown">
                        <div>
                          <button
                            type="button"
                            class="block w-full px-4 py-2 text-left text-sm text-gray-700 hover:bg-gray-100"
                            phx-click="edit"
                            phx-value-id={otp.id}
                            phx-target="#otp-management"
                            patch={~p"/Admin/otp-management/#{otp.id}/edit"}
                          >
                            <span class="sr-only">Open options</span>
                            <!-- Heroicon name: solid/dots-vertical -->
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                              <path d="M10 6a2 2 0 110-4 2 2 0 010 4zM10 12a2 2 0 110-4 2 2 0 010 4zM10 18a2 2 0 110-4 2 2 0 010 4z" />
                            </svg>
                          </button>
                        </div>

                        <!-- Dropdown menu -->
                        <div 
                          class="hidden origin-top-right absolute right-0 mt-2 w-48 rounded-md shadow-lg bg-white ring-1 ring-black ring-opacity-5 focus:outline-none z-10" 
                          role="menu" 
                          aria-orientation="vertical" 
                          aria-labelledby={"menu-button-#{otp.id}"}
                          tabindex="-1"
                        >
                          <div class="py-1" role="none">
                            <!-- Active: "bg-gray-100 text-gray-900", Not Active: "text-gray-700" -->
                            <.link 
                              patch={~p"/Admin/otp-management/#{otp}/edit"}
                              class="text-gray-700 block px-4 py-2 text-sm hover:bg-gray-100"
                              role="menuitem" 
                              tabindex="-1" 
                              id={"menu-item-0-#{otp.id}"}
                            >
                              Edit
                            </.link>
                            
                            <button 
                              type="button" 
                              phx-click="toggle_active" 
                              phx-value-id={otp.id}
                              class="w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
                              role="menuitem" 
                              tabindex="-1" 
                              id={"menu-item-1-#{otp.id}"}
                            >
                              <%= if otp.is_active, do: "Deactivate", else: "Activate" %>
                            </button>
                            
                            <button 
                              type="button" 
                              phx-click={JS.push("delete", value: %{id: otp.id})}
                              data-confirm="Are you sure you want to delete this OTP?"
                              class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-gray-100"
                              role="menuitem" 
                              tabindex="-1" 
                              id={"menu-item-2-#{otp.id}"}
                            >
                              Delete
                            </button>
                          </div>
                        </div>
                      </div>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<.modal :if={@live_action in [:new, :edit]} id="otp-modal" show on_cancel={JS.patch("/Admin/otp-management")}>
  <.live_component
    module={RegisterWeb.Admin.OTPManagementLive.FormComponent}
    id={@otp.id || :new}
    title={@page_title}
    action={@live_action}
    otp={@otp}
    return_to={~p"/Admin/otp-management"}
    current_user={@current_user}
  />
</.modal>
