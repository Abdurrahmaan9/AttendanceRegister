<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <div class="md:flex md:items-center md:justify-between mb-6">
    <div class="flex-1 min-w-0">
      <h1 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
        <%= @page_title %>
      </h1>
    </div>
  </div>

  <%= if @live_action == :edit do %>
    <div class="bg-white shadow overflow-hidden sm:rounded-lg mb-8">
      <div class="px-4 py-5 sm:px-6">
        <h3 class="text-lg leading-6 font-medium text-gray-900">
          Courses for <%= @lecturer.first_name %> <%= @lecturer.last_name %>
        </h3>
        <p class="mt-1 max-w-2xl text-sm text-gray-500">
          Manage course assignments for this lecturer
        </p>
      </div>

      <div class="border-t border-gray-200 px-4 py-5 sm:p-0">
        <dl class="sm:divide-y sm:divide-gray-200">
          <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
            <dt class="text-sm font-medium text-gray-500">Current Courses</dt>
            <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
              <%= if @lecturer.lecturer_courses != [] do %>
                <ul class="border border-gray-200 rounded-md divide-y divide-gray-200">
                  <%= for lc <- @lecturer.lecturer_courses do %>
                    <li class="pl-3 pr-4 py-3 flex items-center justify-between text-sm">
                      <div class="w-0 flex-1 flex items-center">
                        <span class="flex-1 w-0 truncate">
                          <%= lc.course.title %>
                        </span>
                        <%= if lc.is_primary do %>
                          <span class="ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                            Primary
                          </span>
                        <% end %>
                      </div>
                      <div class="ml-4 flex-shrink-0 flex space-x-4">
                        <%= unless lc.is_primary do %>
                           <button 
                           phx-click="set_primary" 
                           phx-value-user_id={@lecturer.id}
                           phx-value-course_id={lc.course_id}
                           class="text-blue-600 hover:text-blue-900"
                           >
                           Set as primary
                           </button>

                           <button 
                           phx-click="remove_course" 
                           phx-value-user_id={@lecturer.id}
                           phx-value-course_id={lc.course_id}
                           class="text-red-600 hover:text-red-900"
                           data-confirm="Are you sure you want to remove this course?"
                           >
                           Remove
                           </button>
                        <% end %>
                      </div>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <p class="text-gray-500 italic">No courses assigned yet</p>
              <% end %>
            </dd>
          </div>

          <%= if @unassigned_courses != [] do %>
            <div class="py-4 sm:py-5 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6">
              <dt class="text-sm font-medium text-gray-500">Available Courses</dt>
              <dd class="mt-1 text-sm text-gray-900 sm:mt-0 sm:col-span-2">
               <form phx-submit="assign_course" class="flex">
                  <input type="hidden" name="user_id" value={@lecturer.id} />
                  <div class="flex-1">
                     <select 
                        name="course_id" 
                        class="mt-1 block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-teal-500 focus:border-teal-500 sm:text-sm rounded-md"
                        required
                     >
                        <option value="">Select a course</option>
                        <%= for course <- @unassigned_courses do %>
                        <option value={course.id}><%= course.title %></option>
                        <% end %>
                     </select>
                  </div>
                  <div class="ml-3">
                     <button 
                        type="submit" 
                        class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-gradient-to-r from-teal-500 to-teal-600 hover:bg-teal-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500"
                     >
                        Add Course
                     </button>
                  </div>
               </form>
              </dd>
            </div>
          <% end %>
        </dl>
      </div>
    </div>

    <div class="flex justify-end">
      <.link 
        patch={~p"/Admin/lecturers"}
        class="bg-white py-2 px-4 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500"
      >
        Back to List
      </.link>
    </div>

  <% else %>
    <div class="bg-white shadow overflow-hidden sm:rounded-lg">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Lecturer
              </th>
              <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                Courses
              </th>
              <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <%= for lecturer <- @lecturers do %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="flex items-center">
                    <div class="flex-shrink-0 h-10 w-10 rounded-full bg-gray-200 flex items-center justify-center">
                      <span class="text-gray-600 text-lg font-medium">
                        <%= String.first(lecturer.first_name) %><%= String.first(lecturer.last_name) %>
                      </span>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-900">
                        <%= lecturer.first_name %> <%= lecturer.last_name %>
                      </div>
                      <div class="text-sm text-gray-500"><%= lecturer.email %></div>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="text-sm text-gray-900">
                    <%= if lecturer.lecturer_courses != [] do %>
                      <div class="flex flex-wrap gap-2">
                        <%= for lc <- lecturer.lecturer_courses do %>
                          <span class={"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium 
                            #{if lc.is_primary, do: "bg-teal-100 text-teal-800", else: "bg-gray-100 text-gray-800"}"}>
                            <%= lc.course.name %>
                            <%= if lc.is_primary do %>
                              <span class="ml-1">★</span>
                            <% end %>
                          </span>
                        <% end %>
                      </div>
                    <% else %>
                      <span class="text-gray-500 italic">No courses assigned</span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <.link 
                    patch={Routes.admin_lecturer_courses_path(@socket, :edit, lecturer.id)}
                    class="text-teal-600 hover:text-teal-900"
                  >
                    Manage
                  </.link>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
</div>