<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Lecturer Management</h1>
</div>

<!-- Add Lecturer -->
<div class="bg-white shadow rounded-lg p-4 mb-6">
  <h2 class="text-sm font-medium text-gray-700 mb-3">
    Add Lecturer
  </h2>

  <form phx-submit="create_lecturer" class="grid grid-cols-1 sm:grid-cols-5 gap-3">
    <input
      name="first_name"
      type="text"
      placeholder="First name"
      required
      class="block w-full rounded-md border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm"
    />
    <input
      name="last_name"
      type="text"
      placeholder="Last name"
      required
      class="block w-full rounded-md border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm"
    />
    <input
      name="email"
      type="email"
      placeholder="Email"
      required
      class="block w-full rounded-md border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm"
    />
    <input
      name="phone"
      type="tel"
      placeholder="Phone (optional)"
      class="block w-full rounded-md border-gray-300 shadow-sm focus:border-teal-500 focus:ring-teal-500 sm:text-sm"
    />
    <button
      type="submit"
      class="btn bg-gradient-to-r from-teal-500 to-teal-600 text-white hover:from-teal-600 hover:to-teal-700 border-0"
    >
      Add Lecturer
    </button>
  </form>
</div>

<div class="bg-white shadow rounded-lg">

  <div :if={@loading}>
    <.data_loader />
  </div>

  <.table :if={!@loading} id="tbl_lecturers" rows={@lecturers}>
    <:col :let={lecturer} label="Email" filter_item="email">
      <%= lecturer.email %>
    </:col>

    <:col :let={lecturer} label="Role" filter_item="role">
      <span class="inline-flex px-2 py-1 text-xs font-semibold rounded-full bg-gray-100 text-gray-800">
        <%= String.capitalize(lecturer.role) %>
      </span>
    </:col>

    <:action :let={lecturer}>
      <.flowbite_dropdown button_text="Options" row_index={lecturer.id}>
        <:item>
          <.link
            patch={~p"/Admin/lecturers/#{lecturer.id}/courses"}
            class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
          >
            <i class="fas fa-book mr-2"></i> Manage Courses
          </.link>
        </:item>

        <:item>
          <button
            phx-click={show_modal("remove-lecturer-#{lecturer.id}")}
            class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
          >
            <i class="fas fa-user-times mr-2"></i> Remove
          </button>
        </:item>
      </.flowbite_dropdown>

      <!-- Remove Confirmation Modal -->
      <.modal id={"remove-lecturer-#{lecturer.id}"}>
        <:title>Confirm Removal</:title>
        <:content>
          <p class="text-gray-600 mb-4">
            Are you sure you want to remove lecturer
            "<%= lecturer.email %>"?
          </p>
        </:content>
        <:.confirm phx-click="remove_user" phx-value-id={lecturer.id}>
          Remove
        </:.confirm>
      </.modal>
    </:action>
  </.table>
</div>

<%= if Enum.empty?(@lecturers) and not @loading do %>
  <p class="text-center text-sm text-gray-500 mt-6">
    No lecturers found.
  </p>
<% end %>
