<!-- Main Content -->
<div class="w-full">
    <!-- Stats Grid -->
    <div class="p-6">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Stats Cards -->
            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-500 text-sm">Total Students</p>
                        <h3 class="text-2xl font-bold text-blue-800"><%= @total_students %></h3>
                    </div>
                    <div class="bg-blue-100 p-3 rounded-full">
                        <i class="fas fa-users text-blue-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="text-green-500 text-sm font-medium"><i class="fas fa-arrow-up"></i> 5.2%</span>
                    <span class="text-gray-500 text-sm ml-2">vs last week</span>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-500 text-sm">Total Staff</p>
                        <h3 class="text-2xl font-bold text-purple-800">187</h3>
                    </div>
                    <div class="bg-purple-100 p-3 rounded-full">
                        <i class="fas fa-chalkboard-teacher text-purple-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="text-green-500 text-sm font-medium"><i class="fas fa-arrow-up"></i> 2.1%</span>
                    <span class="text-gray-500 text-sm ml-2">vs last week</span>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-500 text-sm">Today's Classes</p>
                        <h3 class="text-2xl font-bold text-green-800">42</h3>
                    </div>
                    <div class="bg-green-100 p-3 rounded-full">
                        <i class="fas fa-book-open text-green-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="text-red-500 text-sm font-medium"><i class="fas fa-arrow-down"></i> 3.7%</span>
                    <span class="text-gray-500 text-sm ml-2">vs yesterday</span>
                </div>
            </div>

            <div class="bg-white rounded-lg shadow p-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-gray-500 text-sm">Today's Sign-ins</p>
                        <h3 class="text-2xl font-bold text-orange-800">1,032</h3>
                    </div>
                    <div class="bg-orange-100 p-3 rounded-full">
                        <i class="fas fa-sign-in-alt text-orange-600 text-xl"></i>
                    </div>
                </div>
                <div class="mt-2">
                    <span class="text-green-500 text-sm font-medium"><i class="fas fa-arrow-up"></i> 8.5%</span>
                    <span class="text-gray-500 text-sm ml-2">vs yesterday</span>
                </div>
            </div>
        </div>

        <!-- System Performance Summary -->
        <div class="mt-8">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">System Performance</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                <div class="bg-white rounded-lg shadow p-4">
                    <p class="text-gray-500 text-sm">Uptime</p>
                    <h3 class="text-xl font-bold text-gray-800"><%= @uptime_min %> min</h3>
                </div>
                <div class="bg-white rounded-lg shadow p-4">
                    <p class="text-gray-500 text-sm">Memory</p>
                    <h3 class="text-xl font-bold text-gray-800"><%= @memory_mb %> MB</h3>
                </div>
                <div class="bg-white rounded-lg shadow p-4">
                    <p class="text-gray-500 text-sm">Run Queue</p>
                    <h3 class="text-xl font-bold text-gray-800"><%= @run_queue %></h3>
                </div>
                <div class="bg-white rounded-lg shadow p-4">
                    <p class="text-gray-500 text-sm">IO In</p>
                    <h3 class="text-xl font-bold text-gray-800"><%= @io_in_kbs %> KB/s</h3>
                </div>
                <div class="bg-white rounded-lg shadow p-4">
                    <p class="text-gray-500 text-sm">IO Out</p>
                    <h3 class="text-xl font-bold text-gray-800"><%= @io_out_kbs %> KB/s</h3>
                </div>
            </div>
        </div>

        <!-- Main Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            <!-- Daily Sign-ins Chart -->
            <div class="bg-white rounded-lg shadow p-6 lg:col-span-2">
                <div class="flex justify-between items-center mb-4">
                    <h2 class="text-lg font-semibold text-gray-800">Daily Sign-ins Overview</h2>
                    <div class="flex space-x-2">
                        <button class="px-3 py-1 text-xs bg-blue-100 text-blue-800 rounded-md">Day</button>
                        <button class="px-3 py-1 text-xs bg-gray-100 text-gray-800 rounded-md">Week</button>
                        <button class="px-3 py-1 text-xs bg-gray-100 text-gray-800 rounded-md">Month</button>
                    </div>
                </div>
                <canvas id="dailySigninsChart" height="250"></canvas>
            </div>

            <!-- Sign-in Distribution -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Sign-in Distribution</h2>
                <canvas id="signinDistributionChart" height="250"></canvas>
            </div>
        </div>

        <!-- System Charts -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Memory Usage (MB)</h2>
                <canvas id="systemMemChart" height="220"></canvas>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Run Queue</h2>
                <canvas id="systemRunqChart" height="220"></canvas>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">IO Throughput (KB/s)</h2>
                <canvas id="systemIOChart" height="220"></canvas>
            </div>
        </div>

        <!-- Hidden data element for LiveView Hook to read -->
        <div id="system-metrics-data"
            phx-hook="SystemCharts"
            data-labels={Jason.encode!(@labels)}
            data-mem-series={Jason.encode!(@mem_series)}
            data-runq-series={Jason.encode!(@runq_series)}
            data-ioin-series={Jason.encode!(@ioin_series)}
            data-ioout-series={Jason.encode!(@ioout_series)}
            class="hidden">
        </div>

        <!-- Statistical Overview -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            <div class="bg-white rounded-lg shadow p-6 lg:col-span-2">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Students by Program</h2>
                <canvas id="progBarChart" height="260"></canvas>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">New Users (7 days)</h2>
                <canvas id="usersLineChart" height="260"></canvas>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">OTP Status</h2>
                <canvas id="otpDonutChart" height="240"></canvas>
            </div>
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">QR Codes Status</h2>
                <canvas id="qrDonutChart" height="240"></canvas>
            </div>
        </div>

        <!-- Hidden data for statistical charts -->
        <div id="stats-data"
             phx-hook="StatsCharts"
             data-prog-labels={Jason.encode!(@prog_labels || [])}
             data-prog-counts={Jason.encode!(@prog_counts || [])}
             data-users-labels={Jason.encode!(@users_labels || [])}
             data-users-counts={Jason.encode!(@users_counts || [])}
             data-otps-active={@otps_active || 0}
             data-otps-inactive={@otps_inactive || 0}
             data-qr-active={@qr_active || 0}
             data-qr-expired={@qr_expired || 0}
             class="hidden">
        </div>

        <!-- Bottom Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Today's Classes -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Today's Classes</h2>
                <div class="space-y-4">
                    <div class="flex items-center justify-between p-3 bg-blue-50 rounded-lg">
                        <div>
                            <h4 class="font-medium">Introduction to Computer Science</h4>
                            <p class="text-sm text-gray-500">9:00 AM - 10:30 AM | Room A12</p>
                        </div>
                        <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded text-xs">Ongoing</span>
                    </div>
                    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                        <div>
                            <h4 class="font-medium">Advanced Mathematics</h4>
                            <p class="text-sm text-gray-500">11:00 AM - 12:30 PM | Room B05</p>
                        </div>
                        <span class="bg-gray-100 text-gray-800 px-2 py-1 rounded text-xs">Upcoming</span>
                    </div>
                    <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
                        <div>
                            <h4 class="font-medium">Modern Physics</h4>
                            <p class="text-sm text-gray-500">2:00 PM - 3:30 PM | Room C21</p>
                        </div>
                        <span class="bg-gray-100 text-gray-800 px-2 py-1 rounded text-xs">Upcoming</span>
                    </div>
                    <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
                        <div>
                            <h4 class="font-medium">Literature Seminar</h4>
                            <p class="text-sm text-gray-500">8:00 AM - 9:00 AM | Room D08</p>
                        </div>
                        <span class="bg-green-100 text-green-800 px-2 py-1 rounded text-xs">Completed</span>
                    </div>
                </div>
            </div>

            <!-- Weekly Attendance Trend -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Weekly Attendance Trend</h2>
                <canvas id="weeklyTrendChart" height="250"></canvas>
            </div>

            <!-- Recent Sign-ins -->
            <div class="bg-white rounded-lg shadow p-6">
                <h2 class="text-lg font-semibold text-gray-800 mb-4">Recent Sign-ins</h2>
                <div class="space-y-3">
                    <div class="flex items-center space-x-3 p-2 hover:bg-gray-50 rounded-lg">
                        <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="User" class="w-10 h-10 rounded-full">
                        <div>
                            <h4 class="font-medium">Sarah Johnson</h4>
                            <p class="text-sm text-gray-500">Student | 8:42 AM</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3 p-2 hover:bg-gray-50 rounded-lg">
                        <img src="https://randomuser.me/api/portraits/men/22.jpg" alt="User" class="w-10 h-10 rounded-full">
                        <div>
                            <h4 class="font-medium">Dr. Michael Brown</h4>
                            <p class="text-sm text-gray-500">Lecturer | 8:15 AM</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3 p-2 hover:bg-gray-50 rounded-lg">
                        <img src="https://randomuser.me/api/portraits/women/33.jpg" alt="User" class="w-10 h-10 rounded-full">
                        <div>
                            <h4 class="font-medium">Emily Wilson</h4>
                            <p class="text-sm text-gray-500">Student | 8:05 AM</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3 p-2 hover:bg-gray-50 rounded-lg">
                        <img src="https://randomuser.me/api/portraits/men/45.jpg" alt="User" class="w-10 h-10 rounded-full">
                        <div>
                            <h4 class="font-medium">Robert Davis</h4>
                            <p class="text-sm text-gray-500">Staff | 7:58 AM</p>
                        </div>
                    </div>
                    <div class="flex items-center space-x-3 p-2 hover:bg-gray-50 rounded-lg">
                        <img src="https://randomuser.me/api/portraits/women/28.jpg" alt="User" class="w-10 h-10 rounded-full">
                        <div>
                            <h4 class="font-medium">Jessica Lee</h4>
                            <p class="text-sm text-gray-500">Student | 7:45 AM</p>
                        </div>
                        <button class="ml-auto p-2 text-gray-500 hover:text-gray-700"><i class="fas fa-ellipsis-v"></i>
                        </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script>
// Set current date
const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
document.getElementById('current-date').textContent = new Date().toLocaleDateString('en-US', options);

// Daily Sign-ins Chart
const dailySigninsCtx = document.getElementById('dailySigninsChart').getContext('2d');
const dailySigninsChart = new Chart(dailySigninsCtx, {
    type: 'line',
    data: {
        labels: ['6:00 AM', '8:00 AM', '10:00 AM', '12:00 PM', '2:00 PM', '4:00 PM'],
        datasets: [
            {
                label: 'Students',
                data: [120, 450, 320, 180, 250, 150],
                borderColor: '#3B82F6',
                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                tension: 0.3,
                fill: true
            },
            {
                label: 'Staff',
                data: [30, 120, 80, 40, 60, 30],
                borderColor: '#8B5CF6',
                backgroundColor: 'rgba(139, 92, 246, 0.1)',
                tension: 0.3,
                fill: true
            },
            {
                label: 'Lecturers',
                data: [15, 60, 40, 20, 30, 15],
                borderColor: '#10B981',
                backgroundColor: 'rgba(16, 185, 129, 0.1)',
                tension: 0.3,
                fill: true
            }
        ]
    },
    options: {
        responsive: true,
        plugins: {
            legend: {
                position: 'top',
            },
            tooltip: {
                mode: 'index',
                intersect: false,
            }
        },
        scales: {
            y: {
                beginAtZero: true,
                ticks: {
                    callback: function(value) {
                        return value;
                    }
                }
            }
        }
    }
});

// Sign-in Distribution Chart
const signinDistributionCtx = document.getElementById('signinDistributionChart').getContext('2d');
const signinDistributionChart = new Chart(signinDistributionCtx, {
    type: 'doughnut',
    data: {
        labels: ['Students', 'Staff', 'Lecturers'],
        datasets: [{
            data: [780, 150, 102],
            backgroundColor: [
                '#3B82F6',
                '#8B5CF6',
                '#10B981'
            ],
            borderWidth: 1
        }]
    },
    options: {
        responsive: true,
        plugins: {
            legend: {
                position: 'bottom',
            },
            tooltip: {
                callbacks: {
                    label: function(context) {
                        const label = context.label || '';
                        const value = context.raw || 0;
                        const total = context.dataset.data.reduce((a, b) => a + b, 0);
                        const percentage = Math.round((value / total) * 100);
                        return `${label}: ${value} (${percentage}%)`;
                    }
                }
            }
        }
    }
});

// Weekly Trend Chart
const weeklyTrendCtx = document.getElementById('weeklyTrendChart').getContext('2d');
const weeklyTrendChart = new Chart(weeklyTrendCtx, {
    type: 'bar',
    data: {
        labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'],
        datasets: [
            {
                label: 'Students',
                data: [650, 720, 680, 740, 800, 150],
                backgroundColor: '#3B82F6',
            },
            {
                label: 'Staff',
                data: [120, 140, 130, 150, 160, 30],
                backgroundColor: '#8B5CF6',
            },
            {
                label: 'Lecturers',
                data: [80, 90, 85, 95, 100, 20],
                backgroundColor: '#10B981',
            }
        ]
    },
    options: {
        responsive: true,
        plugins: {
            legend: {
                position: 'top',
            },
            tooltip: {
                mode: 'index',
                intersect: false,
            }
        },
        scales: {
            x: {
                stacked: false,
            },
            y: {
                stacked: false,
                beginAtZero: true
            }
        }
    }
});
</script>
