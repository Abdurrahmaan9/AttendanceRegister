<!-- Main Content -->
<div class="w-full bg-gray-50">
    <!-- Key Metrics Grid -->
    <div class="p-6">
        <!-- Academic Metrics Section -->
        <div class="mb-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-gray-800">Academic Overview</h2>
                <div class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                    Educational Metrics
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Total Students Card -->
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
                    <%= if @loading do %>
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                <.data_loader />
                                <p class="mt-2 text-sm text-gray-600">Loading data...</p>
                            </div>
                        </div>
                    <% else %>
                        <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
                            <div class="flex items-center justify-between">
                                <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                    </svg>
                                </div>
                                <div class="text-right">
                                    <p class="text-blue-100 text-sm font-medium">Total Students</p>
                                    <h3 class="text-2xl font-bold text-white"><%= @total_students %></h3>
                                </div>
                            </div>
                        </div>
                        <div class="p-4 bg-blue-50">
                            <div class="flex items-center justify-between">
                                <span class="text-blue-600 text-sm font-medium flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                                    </svg>
                                    12% increase
                                </span>
                                <span class="text-gray-500 text-xs">vs last month</span>
                            </div>
                        </div>
                    <% end %>
                </div>

                <!-- Courses Onboarded Card -->
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
                    <%= if @loading do %>
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                <.data_loader />
                                <p class="mt-2 text-sm text-gray-600">Loading data...</p>
                            </div>
                        </div>
                    <% else %>
                        <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
                            <div class="flex items-center justify-between">
                                <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                                    </svg>
                                </div>
                                <div class="text-right">
                                    <p class="text-green-100 text-sm font-medium">Courses Onboarded</p>
                                    <h3 class="text-2xl font-bold text-white"><%= @total_courses %></h3>
                                </div>
                            </div>
                        </div>
                        <div class="p-4 bg-green-50">
                            <div class="flex items-center justify-between">
                                <span class="text-green-600 text-sm font-medium flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    All active
                                </span>
                                <span class="text-gray-500 text-xs">programs</span>
                            </div>
                        </div>
                    <% end %>
                </div>

                <!-- Programs Card -->
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
                    <%= if @loading do %>
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                <.data_loader />
                                <p class="mt-2 text-sm text-gray-600">Loading data...</p>
                            </div>
                        </div>
                    <% else %>
                        <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
                            <div class="flex items-center justify-between">
                                <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
                                    </svg>
                                </div>
                                <div class="text-right">
                                    <p class="text-indigo-100 text-sm font-medium">Academic Programs</p>
                                    <h3 class="text-2xl font-bold text-white"><%= @total_programs %></h3>
                                </div>
                            </div>
                        </div>
                        <div class="p-4 bg-blue-50">
                            <div class="flex items-center justify-between">
                                <span class="text-blue-600 text-sm font-medium flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    Active programs
                                </span>
                                <span class="text-gray-500 text-xs">total</span>
                            </div>
                        </div>
                    <% end %>
                </div>

                <!-- Staff Members Card -->
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
                    <%= if @loading do %>
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                <.data_loader />
                                <p class="mt-2 text-sm text-gray-600">Loading data...</p>
                            </div>
                        </div>
                    <% else %>
                        <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
                            <div class="flex items-center justify-between">
                                <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                </div>
                                <div class="text-right">
                                    <p class="text-teal-100 text-sm font-medium">Staff Members</p>
                                    <h3 class="text-2xl font-bold text-white"><%= @total_staff %></h3>
                                </div>
                            </div>
                        </div>
                        <div class="p-4 bg-green-50">
                            <div class="flex items-center justify-between">
                                <span class="text-green-600 text-sm font-medium flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                    </svg>
                                    Faculty & admin
                                </span>
                                <span class="text-gray-500 text-xs">total staff</span>
                            </div>
                        </div>
                    <% end %>
                </div>
            </div>
        </div>

        <!-- Daily Operations Section -->
        <div class="mb-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <!-- Today's Attendance Card -->
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
                    <%= if @loading do %>
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                <.data_loader />
                                <p class="mt-2 text-sm text-gray-600">Loading data...</p>
                            </div>
                        </div>
                    <% else %>
                        <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
                            <div class="flex items-center justify-between">
                                <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                                    </svg>
                                </div>
                                <div class="text-right">
                                    <p class="text-purple-100 text-sm font-medium">Today's Attendance</p>
                                    <h3 class="text-2xl font-bold text-white"><%= @today_attendance %></h3>
                                </div>
                            </div>
                        </div>
                        <div class="p-4 bg-blue-50">
                            <div class="flex items-center justify-between">
                                <span class="text-blue-600 text-sm font-medium flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    Live tracking
                                </span>
                                <span class="text-gray-500 text-xs"><%= @total_sessions_for_day %> sessions</span>
                            </div>
                        </div>
                    <% end %>
                </div>

                <!-- Today's Classes Card -->
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
                    <%= if @loading do %>
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                <.data_loader />
                                <p class="mt-2 text-sm text-gray-600">Loading data...</p>
                            </div>
                        </div>
                    <% else %>
                        <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
                            <div class="flex items-center justify-between">
                                <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                                <div class="text-right">
                                    <p class="text-pink-100 text-sm font-medium">Today's Classes</p>
                                    <h3 class="text-2xl font-bold text-white"><%= @total_sessions_for_day %></h3>
                                </div>
                            </div>
                        </div>
                        <div class="p-4 bg-green-50">
                            <div class="flex items-center justify-between">
                                <span class="text-green-600 text-sm font-medium flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    Scheduled
                                </span>
                                <span class="text-gray-500 text-xs">today</span>
                            </div>
                        </div>
                    <% end %>
                </div>

                <!-- QR Codes Generated Card -->
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
                    <%= if @loading do %>
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                <.data_loader />
                                <p class="mt-2 text-sm text-gray-600">Loading data...</p>
                            </div>
                        </div>
                    <% else %>
                        <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
                            <div class="flex items-center justify-between">
                                <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                                    </svg>
                                </div>
                                <div class="text-right">
                                    <p class="text-orange-100 text-sm font-medium">QR Codes Generated</p>
                                    <h3 class="text-2xl font-bold text-white"><%= @total_qr_codes %></h3>
                                </div>
                            </div>
                        </div>
                        <div class="p-4 bg-blue-50">
                            <div class="flex items-center justify-between">
                                <span class="text-blue-600 text-sm font-medium flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                    </svg>
                                    Active: <%= @qr_active || 0 %>
                                </span>
                                <span class="text-gray-500 text-xs">total generated</span>
                            </div>
                        </div>
                    <% end %>
                </div>

                <!-- OTPs Generated Card -->
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
                    <%= if @loading do %>
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                <.data_loader />
                                <p class="mt-2 text-sm text-gray-600">Loading data...</p>
                            </div>
                        </div>
                    <% else %>
                        <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
                            <div class="flex items-center justify-between">
                                <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                                    </svg>
                                </div>
                                <div class="text-right">
                                    <p class="text-red-100 text-sm font-medium">OTPs Generated</p>
                                    <h3 class="text-2xl font-bold text-white"><%= @total_otps %></h3>
                                </div>
                            </div>
                        </div>
                        <div class="p-4 bg-green-50">
                            <div class="flex items-center justify-between">
                                <span class="text-green-600 text-sm font-medium flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                    </svg>
                                    Security codes
                                </span>
                                <span class="text-gray-500 text-xs">total generated</span>
                            </div>
                        </div>
                    <% end %>
                </div>
            </div>
        </div>

        <!-- System Performance Summary -->
        <div class="mt-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-gray-800">System Performance</h2>
                <div class="flex items-center space-x-2">
                    <div class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                    <span class="text-sm text-gray-600">Live monitoring</span>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-4">
                    <div class="flex items-center justify-between mb-2">
                        <p class="text-gray-600 text-sm font-medium">Uptime</p>
                        <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800"><%= @uptime_min %> min</h3>
                </div>
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-4">
                    <div class="flex items-center justify-between mb-2">
                        <p class="text-gray-600 text-sm font-medium">Memory</p>
                        <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800"><%= @memory_mb %> MB</h3>
                </div>
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-4">
                    <div class="flex items-center justify-between mb-2">
                        <p class="text-gray-600 text-sm font-medium">Run Queue</p>
                        <svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800"><%= @run_queue %></h3>
                </div>
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-4">
                    <div class="flex items-center justify-between mb-2">
                        <p class="text-gray-600 text-sm font-medium">IO In</p>
                        <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800"><%= @io_in_kbs %> KB/s</h3>
                </div>
                <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-4">
                    <div class="flex items-center justify-between mb-2">
                        <p class="text-gray-600 text-sm font-medium">IO Out</p>
                        <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8V4m0 0l-4 4m4-4l4 4M7 20v-4m0 0l-4 4m4-4l4 4"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-gray-800"><%= @io_out_kbs %> KB/s</h3>
                </div>
            </div>
        </div>

        <!-- Charts Section from Lecturer Dashboard -->
        <div class="mt-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-gray-800">Attendance Analytics</h2>
                <div class="flex items-center space-x-2">
                    <div class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm font-medium">
                        Detailed Insights
                    </div>
                </div>
            </div>

            <div class="space-y-6"> 
                    <!-- Today's Session Attendance and Attendance Methods -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
                        <div class="bg-white rounded-lg shadow p-6 lg:col-span-2">
                            <div class="flex justify-between items-center mb-4">
                                <h2 class="text-lg font-semibold text-gray-800">Today's Session Attendance</h2>
                                <div class="flex space-x-2">
                                    <button class="px-3 py-1 text-xs bg-gray-100 text-gray-800 rounded-md">Week</button>
                                    <button class="px-3 py-1 text-xs bg-gray-100 text-gray-800 rounded-md">Month</button>
                                    <button class="px-3 py-1 text-xs bg-gray-100 text-gray-800 rounded-md">Semester</button>
                                </div>
                            </div>
                            <%= if @loading do %>
                                <div class="flex items-center justify-center py-8">
                                    <div class="text-center">
                                        <.data_loader />
                                        <p class="mt-2 text-sm text-gray-600">Loading attendance data...</p>
                                    </div>
                                </div>
                            <% else %>
                                <canvas id="dailySigninsChart" height="130"></canvas>
                            <% end %>
                        </div>

                        <div class="bg-white rounded-lg shadow p-6">
                            <h2 class="text-lg font-semibold text-gray-800 mb-4">Attendance Methods</h2>
                            <%= if @loading do %>
                                <div class="flex items-center justify-center py-8">
                                    <div class="text-center">
                                        <.data_loader />
                                        <p class="mt-2 text-sm text-gray-600">Loading methods data...</p>
                                    </div>
                                </div>
                            <% else %>
                                <canvas id="signinDistributionChart" height="130"></canvas>
                            <% end %>
                        </div>
                    </div>

                    <!-- System Performance Charts -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
                        <div class="bg-white rounded-lg shadow p-6">
                            <h2 class="text-lg font-semibold text-gray-800 mb-4">Memory Usage (MB)</h2>
                            <%= if @loading do %>
                                <div class="flex items-center justify-center py-8">
                                    <div class="text-center">
                                        <.data_loader />
                                        <p class="mt-2 text-sm text-gray-600">Loading memory data...</p>
                                    </div>
                                </div>
                            <% else %>
                                <canvas id="systemMemChart" height="220"></canvas>
                            <% end %>
                        </div>
                        <div class="bg-white rounded-lg shadow p-6">
                            <h2 class="text-lg font-semibold text-gray-800 mb-4">Run Queue</h2>
                            <%= if @loading do %>
                                <div class="flex items-center justify-center py-8">
                                    <div class="text-center">
                                        <.data_loader />
                                        <p class="mt-2 text-sm text-gray-600">Loading queue data...</p>
                                    </div>
                                </div>
                            <% else %>
                                <canvas id="systemRunqChart" height="220"></canvas>
                            <% end %>
                        </div>
                        <div class="bg-white rounded-lg shadow p-6">
                            <h2 class="text-lg font-semibold text-gray-800 mb-4">IO Throughput (KB/s)</h2>
                            <%= if @loading do %>
                                <div class="flex items-center justify-center py-8">
                                    <div class="text-center">
                                        <.data_loader />
                                        <p class="mt-2 text-sm text-gray-600">Loading I/O data...</p>
                                    </div>
                                </div>
                            <% else %>
                                <canvas id="systemIOChart" height="220"></canvas>
                            <% end %>
                        </div>
                    </div>

                    <!-- Attendance by Course and 7-Day Trend -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
                        <div class="bg-white rounded-lg shadow p-6 lg:col-span-2">
                            <h2 class="text-lg font-semibold text-gray-800 mb-4">Attendance by Course</h2>
                            <%= if @loading do %>
                                <div class="flex items-center justify-center py-8">
                                    <div class="text-center">
                                        <.data_loader />
                                        <p class="mt-2 text-sm text-gray-600">Loading course data...</p>
                                    </div>
                                </div>
                            <% else %>
                                <canvas id="progBarChart" height="130"></canvas>
                            <% end %>
                        </div>
                        <div class="bg-white rounded-lg shadow p-6">
                            <h2 class="text-lg font-semibold text-gray-800 mb-4">7-Day Attendance Trend</h2>
                            <%= if @loading do %>
                                <div class="flex items-center justify-center py-8">
                                    <div class="text-center">
                                        <.data_loader />
                                        <p class="mt-2 text-sm text-gray-600">Loading trend data...</p>
                                    </div>
                                </div>
                            <% else %>
                                <canvas id="usersLineChart" height="260"></canvas>
                            <% end %>
                        </div>
                    </div>
                

                <div id="attendance-charts-data" phx-hook="AttendanceCharts" 
                    data-daily-labels={Jason.encode!(@daily_labels || [])} 
                    data-daily-qr-data={Jason.encode!(@daily_qr_data || [])}
                    data-daily-otp-data={Jason.encode!(@daily_otp_data || [])}
                    data-weekly-trend-labels={Jason.encode!(@weekly_trend_labels || [])}
                    data-weekly-trend-data={Jason.encode!(@weekly_trend_data || [])}
                    data-signin-labels={Jason.encode!(["QR Code", "OTP"])}
                    data-signin-qr={@signin_qr || 0}
                    data-signin-otp={@signin_otp || 0}
                    class="hidden">
                </div>

                <div id="system-metrics-data" phx-hook="SystemCharts" data-labels={Jason.encode!(@labels)} data-mem-series={Jason.encode!(@mem_series)} data-runq-series={Jason.encode!(@runq_series)} data-ioin-series={Jason.encode!(@ioin_series)} data-ioout-series={Jason.encode!(@ioout_series)} class="hidden">
                </div>

                <div id="stats-data" phx-hook="StatsCharts" data-prog-labels={Jason.encode!(@course_labels || [])} data-prog-counts={Jason.encode!(@course_counts || [])} data-users-labels={Jason.encode!(@attendance_labels || [])} data-users-counts={Jason.encode!(@attendance_counts || [])} data-otps-active={@otps_active || 0} data-otps-inactive={@otps_inactive || 0} data-qr-active={@qr_active || 0} data-qr-expired={@qr_expired || 0} class="hidden">
                </div>
            </div>
        </div>

        <!-- Attendance Analytics -->
        <div class="mt-8">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-gray-800">Attendance Analytics</h2>
                <div class="flex items-center space-x-2">
                    <div class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
                        <%= length(@students_per_course) %> courses
                    </div>
                </div>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                <!-- Weekly Attendance Trend -->
                <div>
                    <div class="bg-white rounded-lg shadow p-6">
                        <h2 class="text-lg font-semibold text-gray-800 mb-4">Weekly Attendance Trend</h2>
                        <%= if @loading do %>
                            <div class="flex items-center justify-center py-8">
                                <div class="text-center">
                                    <.data_loader />
                                    <p class="mt-2 text-sm text-gray-600">Loading weekly trend...</p>
                                </div>
                            </div>
                        <% else %>
                            <canvas id="weeklyTrendChart" height="250"></canvas>
                        <% end %>
                    </div>
                </div>
                <div class="lg:col-span-1 bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Students per Course</h3>
                    <%= if @loading do %>
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                <.data_loader />
                                <p class="mt-2 text-sm text-gray-600">Loading course data...</p>
                            </div>
                        </div>
                    <% else %>
                        <div class="space-y-3">
                            <%= for {course_title, student_count} <- @students_per_course do %>
                                <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                                    <div class="flex-1">
                                        <h4 class="font-medium text-gray-800"><%= course_title %></h4>
                                        <div class="mt-2 bg-gray-200 rounded-full h-2">
                                            <div class="bg-blue-500 h-2 rounded-full transition-all duration-300" style={"width: #{min(student_count * 2, 100)}%"}></div>
                                        </div>
                                    </div>
                                    <div class="ml-4 text-right">
                                        <span class="text-lg font-bold text-gray-800"><%= student_count %></span>
                                        <span class="text-sm text-gray-500 ml-1">students</span>
                                    </div>
                                </div>
                            <% end %>
                        </div>
                    <% end %>
                </div>
                <div class="bg-white rounded-xl shadow-lg p-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4">Quick Stats</h3>
                    <%= if @loading do %>
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                <.data_loader />
                                <p class="mt-2 text-sm text-gray-600">Loading statistics...</p>
                            </div>
                        </div>
                    <% else %>
                        <div class="space-y-4">
                            <div class="flex items-center justify-between p-3 bg-blue-50 rounded-lg">
                                <span class="text-sm font-medium text-blue-800">Avg Students/Course</span>
                                <span class="text-lg font-bold text-blue-600">
                                    <%= if length(@students_per_course) > 0 do %>
                                        <%= div(Enum.sum(Enum.map(@students_per_course, fn {_, count} -> count end)), length(@students_per_course)) %>
                                    <% else %>
                                        0
                                    <% end %>
                                    </span>
                            </div>
                            <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
                                <span class="text-sm font-medium text-green-800">Total Enrollments</span>
                                <span class="text-lg font-bold text-green-600">
                                    <%= Enum.sum(Enum.map(@students_per_course, fn {_, count} -> count end)) %>
                                </span>
                            </div>
                            <div class="flex items-center justify-between p-3 bg-purple-50 rounded-lg">
                                <span class="text-sm font-medium text-purple-800">Active Courses</span>
                                <span class="text-lg font-bold text-purple-600"><%= @total_courses %></span>
                            </div>
                        </div>
                    <% end %>
                </div>
            </div>
        </div>

        <!-- Recent Activities Section -->
        <div class="mt-8 mb-6">
            <div class="flex items-center justify-between mb-6">
                <h2 class="text-xl font-bold text-gray-800">Recent Activities</h2>
                <div class="flex items-center space-x-2">
                    <div class="bg-orange-100 text-orange-800 px-3 py-1 rounded-full text-sm font-medium">
                        Live feed
                    </div>
                </div>
            </div>
            <div class="bg-white rounded-xl shadow-lg overflow-hidden">
                <div class="p-6">
                    <%= if @loading do %>
                        <div class="flex items-center justify-center py-8">
                            <div class="text-center">
                                <.data_loader />
                                <p class="mt-2 text-sm text-gray-600">Loading recent activities...</p>
                            </div>
                        </div>
                    <% else %>
                        <div class="space-y-4">
                            <%= for activity <- @recent_activities do %>
                            <div class="flex items-start space-x-4 p-4 hover:bg-gray-50 rounded-lg transition-colors">
                                <!-- Activity Icon -->
                                <div class="flex-shrink-0">
                                    <%= case activity.type do %>
                                        <% "attendance" -> %>
                                            <div class="bg-green-100 p-2 rounded-lg">
                                                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                </svg>
                                            </div>
                                        <% "qr_code" -> %>
                                            <div class="bg-blue-100 p-2 rounded-lg">
                                                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                                                </svg>
                                            </div>
                                        <% "otp" -> %>
                                            <div class="bg-purple-100 p-2 rounded-lg">
                                                <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                                                </svg>
                                            </div>
                                        <% _ -> %>
                                            <div class="bg-gray-100 p-2 rounded-lg">
                                                <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                                </svg>
                                            </div>
                                    <% end %>
                                </div>
                                
                                <!-- Activity Content -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center justify-between">
                                        <div class="flex-1">
                                            <p class="text-sm font-medium text-gray-900">
                                                <span class="font-semibold"><%= activity.user_name %></span>
                                                <span class="text-gray-600 mx-1"><%= activity.action %></span>
                                                <span class="text-blue-600 font-medium"><%= activity.target %></span>
                                            </p>
                                            <div class="mt-1 flex items-center space-x-2 text-xs text-gray-500">
                                                <span><%= activity.user_email %></span>
                                                <span>•</span>
                                                <span><%= Calendar.strftime(activity.timestamp, "%I:%M %p") %></span>
                                                <%= if activity.details do %>
                                                    <span>•</span>
                                                    <span><%= activity.details %></span>
                                                <% end %>
                                            </div>
                                        </div>
                                        <div class="ml-4 flex-shrink-0">
                                            <%= case activity.type do %>
                                                <% "attendance" -> %>
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                                        Attendance
                                                    </span>
                                                <% "qr_code" -> %>
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                                        QR Code
                                                    </span>
                                                <% "otp" -> %>
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                                        OTP
                                                    </span>
                                                <% _ -> %>
                                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
                                                        <%= String.replace(activity.type, "_", " ") |> String.capitalize() %>
                                                    </span>
                                            <% end %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% end %>
                        
                        <%= if length(@recent_activities) == 0 do %>
                            <div class="text-center py-8">
                                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <h3 class="mt-2 text-sm font-medium text-gray-900">No recent activities</h3>
                                <p class="mt-1 text-sm text-gray-500">Activities will appear here as users interact with the system.</p>
                            </div>
                        <% end %>
                    </div>
                <% end %>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="admin-dashboard-charts" phx-hook="AdminDashboardCharts" class="hidden"></div>
