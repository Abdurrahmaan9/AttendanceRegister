<!-- Header -->
<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-semibold text-gray-900">User Management</h1>
</div>

<!-- Tabs -->
<div class="border-b border-gray-200 mb-8">
  <nav class="flex space-x-8">
    <.link
      patch={~p"/Admin/users?tab=all"}
      class={[
        "border-b-2 py-3 px-1 text-sm font-medium",
        @active_tab == "all" &&
          "border-blue-500 text-blue-600" ||
          "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
      ]}
    >
      All Users
    </.link>

    <.link
      patch={~p"/Admin/users?tab=admin"}
      class={[
        "border-b-2 py-3 px-1 text-sm font-medium",
        @active_tab == "admin" &&
          "border-blue-500 text-blue-600" ||
          "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
      ]}
    >
      Admins
    </.link>

    <.link
      patch={~p"/Admin/users?tab=lecturer"}
      class={[
        "border-b-2 py-3 px-1 text-sm font-medium",
        @active_tab == "lecturer" &&
          "border-blue-500 text-blue-600" ||
          "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
      ]}
    >
      Lecturers
    </.link>

    <.link
      patch={~p"/Admin/users?tab=student"}
      class={[
        "border-b-2 py-3 px-1 text-sm font-medium",
        @active_tab == "student" &&
          "border-blue-500 text-blue-600" ||
          "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
      ]}
    >
      Students
    </.link>
  </nav>
</div>

<!-- Table -->
<div class="bg-white shadow rounded-lg">
  <div :if={@loading}>
    <.data_loader />
  </div>


  <.table
    :if={!@loading}
    id="users-table"
    rows={@users}
    empty_message="No users found"
  >
    <:col :let={user} label="Email">
      <span class="font-medium text-gray-900"><%= user.email %></span>
    </:col>

    <:col :let={user} label="Role">
      <span class={[
        "inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium",
        RoleHelper.role_class(user.role)
      ]}>
        <%= String.capitalize(user.role) %>
      </span>
    </:col>

    <:action :let={user}>
      <div class="flex justify-end">
        <form
          phx-submit="update_role"
          phx-change="update_role"
          class="flex items-center gap-2"
        >
          <input type="hidden" name="user_id" value={user.id} />

          <select
            name="role"
            class="block w-full rounded-md border-gray-300 py-2 pl-3 pr-8 text-sm
                    focus:border-blue-500 focus:ring-blue-500"
          >
            <option value="admin" selected={user.role == "admin"}>Admin</option>
            <option value="lecturer" selected={user.role == "lecturer"}>Lecturer</option>
            <option value="student" selected={user.role == "student"}>Student</option>
          </select>
        </form>
      </div>
    </:action>
  </.table>
</div>
