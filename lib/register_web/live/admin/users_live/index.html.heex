<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-xl font-semibold text-gray-900">User Management</h1>
    </div>
  </div>

  <!-- Tabs -->
  <div class="border-b border-gray-200">
    <nav class="-mb-px flex space-x-8">
      <.link 
        patch={~p"/Admin/users?tab=all"}
        class={[
          "whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium",
          @active_tab == "all" && "border-blue-500 text-blue-600" || "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
        ]}
      >
        All Users
      </.link>
      
      <.link 
        patch={~p"/Admin/users?tab=admin"}
        class={[
          "whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium",
          @active_tab == "admin" && "border-blue-500 text-blue-600" || "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
        ]}
      >
        Admins
      </.link>
      
      <.link 
        patch={~p"/Admin/users?tab=lecturer"}
        class={[
          "whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium",
          @active_tab == "lecturer" && "border-blue-500 text-blue-600" || "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
        ]}
      >
        Lecturers
      </.link>
      
      <.link 
        patch={~p"/Admin/users?tab=student"}
        class={[
          "whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium",
          @active_tab == "student" && "border-blue-500 text-blue-600" || "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
        ]}
      >
        Students
      </.link>
    </nav>
  </div>

  <div class="mt-8 flex flex-col">
    <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Email</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Role</th>
                <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                  <span class="sr-only">Actions</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <%= if Enum.empty?(@users) do %>
                <tr>
                  <td colspan="3" class="px-6 py-4 text-center text-sm text-gray-500">
                    No users found
                  </td>
                </tr>
              <% else %>
                <%= for user <- @users do %>
                  <tr>
                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                      <%= user.email %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <span class={"inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium #{RoleHelper.role_class(user.role)}"}>
                        <%= String.capitalize(user.role) %>
                      </span>
                    </td>
                    <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                      <form phx-submit="update_role" phx-change="update_role" class="flex items-center space-x-2">
                        <input type="hidden" name="user_id" value={user.id} />
                        <select name="role" class="block w-full pl-3 pr-10 py-2 text-base border-gray-300 focus:outline-none focus:ring-blue-500 focus:border-blue-500 sm:text-sm rounded-md">
                          <option value="admin" selected={user.role == "admin"}>Admin</option>
                          <option value="lecturer" selected={user.role == "lecturer"}>Lecturer</option>
                          <option value="student" selected={user.role == "student"}>Student</option>
                        </select>
                      </form>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>