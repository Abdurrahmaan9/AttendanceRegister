<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-xl font-semibold text-gray-900">Admins & Staff Management</h1>
    </div>
  </div>

  <!-- Tabs -->
  <div class="border-b border-gray-200 mt-4">
    <nav class="-mb-px flex space-x-8">
      <.link 
        patch={~p"/Admin/admins-staff?tab=admin"}
        class={[
          "whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium",
          @active_tab == "admin" && "border-blue-500 text-blue-600" || "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
        ]}
      >
        Admins
      </.link>
      <.link 
        patch={~p"/Admin/admins-staff?tab=staff"}
        class={[
          "whitespace-nowrap border-b-2 py-4 px-1 text-sm font-medium",
          @active_tab == "staff" && "border-blue-500 text-blue-600" || "border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700"
        ]}
      >
        Staff
      </.link>
    </nav>
  </div>

  <div class="mt-8 flex flex-col">
    <div class="-my-2 -mx-4 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle md:px-6 lg:px-8">
        <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 md:rounded-lg">
          <div class="bg-white p-4">
            <h2 class="text-sm font-medium text-gray-700 mb-3">Add <%= String.capitalize(@active_tab) %></h2>
            <form phx-submit="create_member" class="grid grid-cols-1 sm:grid-cols-3 gap-3">
              <input name="email" type="email" placeholder="Email" required class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" />
              <input name="phone" type="tel" placeholder="Phone number" class="block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500 sm:text-sm" />
              <button type="submit" class="btn btn-primary">Add <%= String.capitalize(@active_tab) %></button>
            </form>
          </div>

          <table class="min-w-full divide-y divide-gray-300">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-6">Email</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Role</th>
                <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <%= if Enum.empty?(@users) do %>
                <tr>
                  <td colspan="3" class="px-6 py-4 text-center text-sm text-gray-500">No users found</td>
                </tr>
              <% else %>
                <%= for user <- @users do %>
                  <tr>
                    <td class="whitespace-nowrap py-4 pl-4 pr-3 text-sm font-medium text-gray-900 sm:pl-6">
                      <%= user.email %>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium">
                        <%= String.capitalize(user.role) %>
                      </span>
                    </td>
                    <td class="whitespace-nowrap px-3 py-4 text-sm text-gray-500">
                      <button phx-click="remove_user" phx-value-id={user.id} class="btn btn-danger">Remove</button>
                    </td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
