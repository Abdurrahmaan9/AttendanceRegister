<!-- Header -->
<div class="flex justify-between items-center mb-8">
<div>
    <h1 class="text-2xl font-semibold text-gray-900">Students</h1>
    <p class="mt-1 text-sm text-gray-500">
    A list of all the students in your account including their name, email, and program.
    </p>
</div>

<.button
    phx-click={JS.push("new_student") |> show_modal("student-modal")}
    variant={:primary}
    class="btn-spacing"
>
    Add student
</.button>
</div>

<!-- Table -->
<div class="bg-white shadow rounded-lg">

<div :if={@loading}>
  <.data_loader />
</div>

<.table
    id="students-table"
    rows={@students}
>
    <:col :let={student} label="Name">
    <span class="font-medium text-gray-900">
        <%= student.first_name %> <%= student.last_name %>
    </span>
    </:col>

    <:col :let={student} label="Email">
    <span class="text-gray-500"><%= student.email %></span>
    </:col>

    <:col :let={student} label="Program">
    <span class="text-gray-500"><%= student.program %></span>
    </:col>

    <:action :let={student}>
    <div class="flex justify-end">
        <.flowbite_dropdown button_text="Options" row_index={student.id}>
        <:trigger>
            <.button variant={:ghost} class="btn-spacing">
            Actions
            </.button>
        </:trigger>

        <:item>
        <.link
            navigate={~p"/Admin/students/#{student.id}"}
            class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
        >
            View
        </.link>
        </:item>

        <:item>
        <button
            type="button"
            class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
            phx-click={JS.push("edit_student", value: %{id: student.id}) |> show_modal("student-modal")}
        >
            Edit
        </button>
        </:item>

        <:item>
        <button
            type="button"
            class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
            phx-click="delete_student"
            phx-value-id={student.id}
            data-confirm="Are you sure you want to delete this student?"
        >
            Delete
        </button>
        </:item>
        </.flowbite_dropdown>
    </div>
    </:action>
</.table>
</div>

<!-- Modal -->
<.modal id="student-modal">
<.live_component
    module={RegisterWeb.Admin.StudentsLive.FormComponent}
    id={"student-#{@editing_id || "new"}"}
    action={if @editing_id, do: :edit, else: :new}
    student={@editing_student || %Student{}}
    return_to={~p"/Admin/students"}
    current_user={@current_user}
/>
</.modal>
