<div class="p-6">
  <h1 class="text-2xl font-semibold mb-4">Attendance View</h1>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="bg-white border rounded p-4 lg:col-span-1">
      <h2 class="text-lg font-semibold mb-3">Filters</h2>

      <div class="space-y-4">
        <form phx-change="select_program">
          <label class="block text-sm font-medium text-gray-700 mb-1">Program</label>
          <select name="program_id" class="w-full border rounded px-3 py-2">
            <option value="">All Programs</option>
            <%= for program <- @programs do %>
              <option value={program.id} selected={@selected_program_id == program.id}>
                <%= program.name %>
              </option>
            <% end %>
          </select>
        </form>

        <%= if @courses != [] do %>
          <form phx-change="select_course">
            <label class="block text-sm font-medium text-gray-700 mb-1">Course / Module</label>
            <select name="course_id" class="w-full border rounded px-3 py-2">
              <option value="">All Courses</option>
              <%= for course <- @courses do %>
                <option value={course.id} selected={@selected_course_id == course.id}>
                  <%= course.title %> (<%= course.code %>)
                </option>
              <% end %>
            </select>
          </form>
        <% end %>
      </div>
    </div>

    <div class="bg-white border rounded p-4 lg:col-span-2">
      <h2 class="text-lg font-semibold mb-3">Summary</h2>

      <%= if @summary do %>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="p-3 border rounded">
            <div class="text-xs text-gray-500">Total Sessions</div>
            <div class="text-xl font-semibold"><%= @summary.total_sessions %></div>
          </div>
          <div class="p-3 border rounded">
            <div class="text-xs text-gray-500">Total Students</div>
            <div class="text-xl font-semibold"><%= @summary.total_students %></div>
          </div>
          <div class="p-3 border rounded">
            <div class="text-xs text-gray-500">Attended</div>
            <div class="text-xl font-semibold text-green-700"><%= @summary.attended %></div>
          </div>
          <div class="p-3 border rounded">
            <div class="text-xs text-gray-500">Attendance Rate</div>
            <div class="text-xl font-semibold"><%= :erlang.float_to_binary(@summary.attendance_rate, decimals: 1) %>%</div>
          </div>
        </div>

        <div class="mt-6">
          <h3 class="text-md font-medium mb-2">Sessions</h3>
          <div class="text-gray-500 text-sm">No sessions to display.</div>
        </div>
      <% else %>
        <div class="text-gray-600">Select a program and optionally a course to view attendance summary.</div>
      <% end %>
    </div>
  </div>
</div>
