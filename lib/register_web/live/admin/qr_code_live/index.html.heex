<div class="flex justify-between items-center mb-6">
  <h1 class="text-2xl font-bold text-gray-900">Generate QR Code</h1>

  <%= if @current_user do %>
    <.button
      phx-click={JS.push("new_qr") |> show_modal("qr-code-modal")}
      class="btn bg-gradient-to-r from-teal-500 to-teal-600 text-white hover:from-teal-600 hover:to-teal-700 border-0"
    >
      New QR Code
    </.button>
  <% end %>
</div>

<%= if @current_user do %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- QR Codes Summary -->
    <div class="bg-white shadow rounded-lg p-4">
      <h2 class="text-sm font-medium text-gray-700">
        QR Codes
      </h2>
      <p class="text-sm text-gray-500 mt-1">
        Generate and manage QR codes for class attendance.
      </p>
    </div>

    <!-- Preview -->
    <div class="bg-white shadow rounded-lg p-4">
      <h2 class="text-sm font-medium text-gray-700 mb-4">Preview</h2>

      <%= if @created_qr && @qr_svg do %>
        <div class="space-y-4">
          <div class="rounded border border-teal-100 bg-teal-50 p-4">
            <p class="text-sm font-medium text-teal-600">Scan this code</p>
            <div class="flex justify-center min-h-[300px] min-w-[300px]">
              <%= Phoenix.HTML.raw(@qr_svg) %>
            </div>
          </div>

          <%= if @created_qr.expires_at do %>
            <p class="text-center text-sm text-gray-500">
              Expires:
              <%= Calendar.strftime(@created_qr.expires_at, "%Y-%m-%d %H:%M") %>
            </p>
          <% end %>
        </div>
      <% else %>
        <div class="rounded border border-dashed border-gray-300 p-6 text-center text-sm text-gray-500">
          Generate a QR code to preview it here.
        </div>
      <% end %>
    </div>
  </div>

  <!-- Your QR Codes -->
  <div class="mb-6">
    <h2 class="text-lg font-semibold text-gray-900 mb-4">
      Your QR Codes
    </h2>

    <div class="bg-white shadow rounded-lg">

      <div :if={@loading}>
        <.data_loader />
      </div>

      <.table :if={!@loading} id="tbl_qr_codes" rows={@qr_codes}>
        <:col :let={qr} label="Name" filter_item="name">
          <%= qr.name %>
        </:col>

        <:col :let={qr} label="Class">
          <%= qr.class_name %>
        </:col>

        <:col :let={qr} label="Program">
          <%= qr.program_name %>
        </:col>

        <:col :let={qr} label="Active">
          <span class={"inline-flex px-2 py-1 text-xs font-semibold rounded-full #{status_color_class(qr.is_active)}"}>
            <%= if qr.is_active, do: "Yes", else: "No" %>
          </span>
        </:col>

        <:col :let={qr} label="Expires">
          <%= qr.expires_at && Calendar.strftime(qr.expires_at, "%Y-%m-%d %H:%M") %>
        </:col>

        <:action :let={qr}>
          <.flowbite_dropdown button_text="Options" row_index={qr.id}>
            <:item>
              <button
                phx-click="view_qr"
                phx-value-id={qr.id}
                class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
              >
                <i class="fas fa-eye mr-2"></i> View
              </button>
            </:item>

            <:item>
              <button
                phx-click={JS.push("edit_qr", value: %{id: qr.id}) |> show_modal("qr-code-modal")}
                class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
              >
                <i class="fas fa-edit mr-2"></i> Edit
              </button>
            </:item>

            <:item>
              <button
                phx-click={show_modal("delete-qr-#{qr.id}")}
                class="block w-full text-left px-4 py-2 text-sm text-gray-700 hover:bg-gray-100"
              >
                <i class="fas fa-trash mr-2"></i> Delete
              </button>
            </:item>
          </.flowbite_dropdown>

          <!-- Delete Confirmation Modal -->
          <.modal id={"delete-qr-#{qr.id}"}>
            <:title>Confirm Deletion</:title>
            <:content>
              <p class="text-gray-600 mb-4">
                Are you sure you want to delete QR code "<%= qr.name %>"?
              </p>
            </:content>
            <:confirm phx-click="delete_qr" phx-value-id={qr.id}>
              Delete
            </:confirm>
          </.modal>
        </:action>
      </.table>
    </div>

    <%= if Enum.empty?(@qr_codes) do %>
      <p class="text-center text-sm text-gray-500 mt-6">
        No QR codes found.
      </p>
    <% end %>
  </div>
<% else %>
  <div class="rounded-lg bg-red-50 border border-red-200 p-4 text-sm text-red-600">
    You must be logged in to view this page.
  </div>
<% end %>

<!-- QR Code Modal -->
<.modal id="qr-code-modal">
  <div class="mb-4">
    <h2 class="text-lg font-semibold">QR Code</h2>
    <p class="text-sm text-gray-500">
      Enter details about the course/module to generate a code for students to scan.
    </p>
  </div>

  <.simple_form
    for={@changeset}
    :let={f}
    as={:qr_code}
    phx-submit="save"
    phx-change="validate"
  >
    <.input field={f[:name]} label="Name" />
    <.input field={f[:description]} label="Description" />
    <.input field={f[:class_name]} label="Class / Module" />
    <.input field={f[:program_name]} label="Program" />
    <.input field={f[:expires_at]} type="datetime-local" label="Expires At" />
    <.input field={f[:is_active]} type="checkbox" label="Active" />

    <:actions>
      <div class="flex items-center gap-2">
        <.button type="submit" class="btn-spacing">
          Generate
        </.button>
        <.button
          variant={:secondary}
          class="btn-spacing"
          phx-click={hide_modal("qr-code-modal")}
        >
          Cancel
        </.button>
      </div>
    </:actions>
  </.simple_form>
</.modal>
