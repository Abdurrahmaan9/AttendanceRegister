<div class="min-h-screen bg-gray-50">
  <!-- Navigation -->
  <nav class="bg-white shadow-sm fixed top-0 left-0 right-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <a href="/dashboard" class="text-2xl font-bold text-blue-600">E-Register</a>
          <span class="ml-4 text-gray-500">|</span>
          <span class="ml-4 text-lg font-medium text-gray-700">QR Code Management</span>
        </div>
        <div class="flex items-center space-x-8">
          <.link
            href={~p"/dashboard"}
            class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors"
          >
            Dashboard
          </.link>
          <.link
            href={~p"/users/settings"}
            class="text-gray-700 hover:text-blue-600 px-3 py-2 rounded-md text-sm font-medium transition-colors"
          >
            Settings
          </.link>
          <.link
            href={~p"/users/log_out"}
            method="delete"
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors"
          >
            Log out
          </.link>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <div class="pt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Header -->
      <div class="mb-8">
        <div class="flex justify-between items-center">
          <div>
            <h1 class="text-3xl font-bold text-gray-900">QR Code Management</h1>
            <p class="mt-2 text-gray-600">Generate and manage QR codes for classes and programs</p>
          </div>
          <button
            :if={!@show_form}
            phx-click="show_form"
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors flex items-center"
          >
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            Generate New QR Code
          </button>
        </div>
      </div>

      <!-- QR Code Generation Form -->
      <div :if={@show_form} class="bg-white shadow rounded-lg p-6 mb-8">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-semibold text-gray-900">Generate QR Code</h2>
          <button
            phx-click="hide_form"
            class="text-gray-400 hover:text-gray-600 transition-colors"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>

        <.form
          for={@form}
          id="qr-code-form"
          phx-change="validate"
          phx-submit="save"
          class="space-y-6"
        >
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <.input
                field={@form[:name]}
                type="text"
                label="QR Code Name"
                placeholder="Enter a descriptive name"
                required
              />
            </div>
            <div>
              <.input
                field={@form[:class_name]}
                type="text"
                label="Class Name"
                placeholder="e.g., Computer Science 101"
                required
              />
            </div>
            <div>
              <.input
                field={@form[:program_name]}
                type="text"
                label="Program Name"
                placeholder="e.g., Bachelor of Science"
                required
              />
            </div>
            <div>
              <.input
                field={@form[:expires_at]}
                type="datetime-local"
                label="Expiration Date (Optional)"
              />
            </div>
          </div>

          <div>
            <.input
              field={@form[:description]}
              type="textarea"
              label="Description (Optional)"
              placeholder="Additional details about this QR code"
              rows="3"
            />
          </div>

          <div class="flex space-x-4">
            <button
              type="button"
              phx-click="generate_qr"
              class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors flex items-center"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
              </svg>
              Generate QR Code
            </button>
            <button
              :if={@qr_svg}
              type="submit"
              class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors flex items-center"
            >
              <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
              </svg>
              Save QR Code
            </button>
          </div>
        </.form>

        <!-- QR Code Preview -->
        <div :if={@qr_svg} class="mt-8 p-6 bg-gray-50 rounded-lg">
          <h3 class="text-lg font-medium text-gray-900 mb-4">QR Code Preview</h3>
          <div class="flex flex-col md:flex-row gap-6">
            <div class="flex-shrink-0">
              <div class="bg-white p-4 rounded-lg shadow-sm border">
                <%= Phoenix.HTML.raw(@qr_svg) %>
              </div>
            </div>
            <div class="flex-1">
              <div class="space-y-3">
                <div>
                  <label class="block text-sm font-medium text-gray-700">QR Code Data:</label>
                  <p class="mt-1 text-sm text-gray-600 bg-white p-2 rounded border font-mono"><%= @generated_qr_code %></p>
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700">Usage Instructions:</label>
                  <p class="mt-1 text-sm text-gray-600">Students can scan this QR code to mark their attendance for the specified class and program.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- QR Codes List -->
      <div class="bg-white shadow rounded-lg">
        <div class="px-6 py-4 border-b border-gray-200">
          <h2 class="text-xl font-semibold text-gray-900">Generated QR Codes</h2>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Class</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Program</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Expires</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <tr :for={qr_code <- @qr_codes} class="hover:bg-gray-50">
                <td class="px-6 py-4 whitespace-nowrap">
                  <div class="text-sm font-medium text-gray-900"><%= qr_code.name %></div>
                  <div :if={qr_code.description} class="text-sm text-gray-500"><%= qr_code.description %></div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= qr_code.class_name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= qr_code.program_name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap">
                  <span class={[
                    "inline-flex px-2 py-1 text-xs font-semibold rounded-full",
                    if(qr_code.is_active, do: "bg-green-100 text-green-800", else: "bg-red-100 text-red-800")
                  ]}>
                    <%= if qr_code.is_active, do: "Active", else: "Inactive" %>
                  </span>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= Calendar.strftime(qr_code.inserted_at, "%Y-%m-%d %H:%M") %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= if qr_code.expires_at do %>
                    <%= Calendar.strftime(qr_code.expires_at, "%Y-%m-%d %H:%M") %>
                  <% else %>
                    Never
                  <% end %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium space-x-2">
                  <button
                    phx-click="toggle_active"
                    phx-value-id={qr_code.id}
                    class={[
                      "px-3 py-1 rounded text-xs font-medium transition-colors",
                      if(qr_code.is_active, 
                        do: "bg-yellow-100 text-yellow-800 hover:bg-yellow-200", 
                        else: "bg-green-100 text-green-800 hover:bg-green-200"
                      )
                    ]}
                  >
                    <%= if qr_code.is_active, do: "Deactivate", else: "Activate" %>
                  </button>
                  <button
                    phx-click="delete"
                    phx-value-id={qr_code.id}
                    data-confirm="Are you sure you want to delete this QR code?"
                    class="px-3 py-1 bg-red-100 text-red-800 hover:bg-red-200 rounded text-xs font-medium transition-colors"
                  >
                    Delete
                  </button>
                </td>
              </tr>
            </tbody>
          </table>
          <div :if={Enum.empty?(@qr_codes)} class="px-6 py-12 text-center">
            <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
            </svg>
            <h3 class="mt-2 text-sm font-medium text-gray-900">No QR codes</h3>
            <p class="mt-1 text-sm text-gray-500">Get started by generating your first QR code.</p>
            <div class="mt-6">
              <button
                phx-click="show_form"
                class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors"
              >
                Generate QR Code
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>