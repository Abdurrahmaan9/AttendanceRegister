<div class="max-w-4xl mx-auto p-4">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-800">QR Code Scanner</h1>
    <button
      phx-click={@camera_active && "stop_scan" || "start_scan"}
      class="btn bg-gradient-to-r from-teal-500 to-teal-600 text-white hover:from-teal-600 hover:to-teal-700 border-0"    
      >
      <%= if @camera_active, do: "Stop Scanning", else: "Start Scanning" %>
    </button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- QR Code Scanner Section -->
    <div class="md:col-span-1">
      <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Scan QR Code</h2>

        <%= if @camera_active do %>
          <div 
            id="qr-scanner-container" 
            phx-hook="QRScanner" 
            phx-update="ignore"
            data-active={@camera_active}
            class="w-full h-64 bg-gray-100 rounded-lg mb-4 overflow-hidden relative transition-all duration-300"
          >
            <!-- Scanner will be mounted here -->
            <div id="qr-reader" class="w-full h-full"></div>
            
            <!-- Scanner overlay with instructions -->
            <div id="qr-scanner-overlay" class="absolute inset-0 flex flex-col items-center justify-center bg-black bg-opacity-70 p-4">
              <div class="text-center text-white mb-4">
                <svg class="mx-auto h-12 w-12 text-white mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
                </svg>
                <h3 class="text-lg font-medium mb-1">Position QR Code in Frame</h3>
                <p class="text-sm text-gray-300">Align the QR code within the frame to scan</p>
              </div>
              
              <!-- Loading indicator -->
              <div class="relative w-full max-w-xs h-1 bg-gray-700 rounded-full overflow-hidden">
                <div class="absolute top-0 left-0 h-full bg-blue-500 animate-pulse" style="width: 100%; animation-duration: 2s;"></div>
              </div>
            </div>
            
            <!-- Error message (hidden by default) -->
            <div id="qr-scanner-error" class="hidden absolute inset-0 flex items-center justify-center bg-red-900 bg-opacity-80 text-white p-4">
              <div class="text-center">
                <svg class="mx-auto h-8 w-8 text-red-300 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                </svg>
                <p class="font-medium" id="qr-error-message">Error message will appear here</p>
              </div>
            </div>
          </div>
        <% else %>
          <div class="w-full h-64 flex items-center justify-center bg-gray-100 rounded-lg mb-4 border-2 border-dashed border-gray-300">
            <div class="text-center p-6">
              <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <h3 class="mt-2 text-sm font-medium text-gray-700">No camera active</h3>
              <p class="mt-1 text-sm text-gray-500">Click "Start Scanning" to begin</p>
            </div>
          </div>
        <% end %>

        <%= if @scanned_data do %>
            <div class="mt-4 p-4 bg-green-50 border border-green-200 rounded-lg">
            <div class="flex items-center">
                <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                </svg>
                </div>
                <div class="ml-3">
                <h3 class="text-sm font-medium text-green-800">Scan Successful!</h3>
                <div class="mt-2 text-sm text-green-700">
                    <p class="font-medium"><%= @scanned_data.name %></p>
                    <p class="mt-1"><span class="font-medium">Class:</span> <%= @scanned_data.class %></p>
                    <p><span class="font-medium">Program:</span> <%= @scanned_data.program %></p>
                    <%= if @scanned_data.expires_at do %>
                    <p class="mt-1">
                        <span class="font-medium">Expires:</span> 
                        <span class={[
                        if(DateTime.compare(@scanned_data.expires_at, DateTime.utc_now()) == :gt,
                            do: "text-green-600",
                            else: "text-yellow-600")
                        ]}>
                        <%= Calendar.strftime(@scanned_data.expires_at, "%b %d, %Y at %H:%M") %>
                        </span>
                    </p>
                    <% end %>
                    <p class="mt-1 text-xs text-gray-500">
                    Scanned at: <%= Calendar.strftime(@scanned_data.scanned_at, "%b %d, %Y at %H:%M") %>
                    </p>
                </div>
                </div>
            </div>
            </div>
        <% end %>

        <%= if @error do %>
            <div class="mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
            <h3 class="font-medium text-red-800">Error</h3>
            <p class="mt-1 text-red-600"><%= @error %></p>
            </div>
        <% end %>
        </div>
    </div>

    <!-- QR Codes List -->
    <div class="md:col-span-2">
        <div class="bg-white rounded-lg shadow-md p-6">
        <h2 class="text-lg font-semibold text-gray-700 mb-4">Available QR Codes</h2>
        
        <%= if Enum.empty?(@qr_codes) do %>
            <p class="text-gray-500 text-center py-8">No QR codes available</p>
        <% else %>
            <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                <tr>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Class</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Program</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                    <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Created</th>
                </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                <%= for qr_code <- @qr_codes do %>
                    <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm font-medium text-gray-900"><%= qr_code.name %></div>
                        <div class="text-sm text-gray-500"><%= String.slice(qr_code.qr_data, 0..10) %>...</div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900"><%= qr_code.class_name %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <div class="text-sm text-gray-900"><%= qr_code.program_name %></div>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap">
                        <span class={[
                        "px-2 inline-flex text-xs leading-5 font-semibold rounded-full",
                        if(qr_code.is_active, do: "bg-green-100 text-green-800", else: "bg-red-100 text-red-800")
                        ]}>
                        <%= if qr_code.is_active, do: "Active", else: "Inactive" %>
                        </span>
                    </td>
                    <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                        <%= Calendar.strftime(qr_code.inserted_at, "%b %d, %Y") %>
                    </td>
                    </tr>
                <% end %>
                </tbody>
            </table>
            </div>
        <% end %>
        </div>
    </div>
    </div>
</div>
