<div class="w-full bg-gray-50">
  <div class="p-6">
    <div class="mb-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-800">My Academic Overview</h2>
        <div class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
          Student Dashboard
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-blue-100 text-sm font-medium">Enrolled Courses</p>
                <h3 class="text-2xl font-bold text-white"><%= @total_courses %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-blue-50">
            <div class="flex items-center justify-between">
              <span class="text-blue-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Active this semester
              </span>
              <span class="text-gray-500 text-xs">current</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-green-100 text-sm font-medium">Total Attendance</p>
                <h3 class="text-2xl font-bold text-white"><%= @total_attendance %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-green-50">
            <div class="flex items-center justify-between">
              <span class="text-green-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
                </svg>
                All time record
              </span>
              <span class="text-gray-500 text-xs">sessions</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-purple-100 text-sm font-medium">Today's Attendance</p>
                <h3 class="text-2xl font-bold text-white"><%= @today_attendance %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-blue-50">
            <div class="flex items-center justify-between">
              <span class="text-blue-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Today's progress
              </span>
              <span class="text-gray-500 text-xs">sessions</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-orange-100 text-sm font-medium">Upcoming Sessions</p>
                <h3 class="text-2xl font-bold text-white"><%= @upcoming_sessions %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-green-50">
            <div class="flex items-center justify-between">
              <span class="text-green-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
                Scheduled
              </span>
              <span class="text-gray-500 text-xs">next days</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-800">My Attendance Analytics</h2>
        <div class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
          Personal Insights
        </div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white rounded-xl shadow-lg p-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Attendance Trend</h3>
          <%= if @loading do %>
            <div class="flex items-center justify-center py-8">
              <div class="text-center">
                <.data_loader />
                <p class="mt-2 text-sm text-gray-600">Loading attendance trend...</p>
              </div>
            </div>
          <% else %>
            <canvas id="attendanceTrendChart" height="130"></canvas>
          <% end %>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Course Distribution</h3>
          <%= if @loading do %>
            <div class="flex items-center justify-center py-8">
              <div class="text-center">
                <.data_loader />
                <p class="mt-2 text-sm text-gray-600">Loading course data...</p>
              </div>
            </div>
          <% else %>
            <canvas id="courseDistChart" height="300"></canvas>
          <% end %>
        </div>
      </div>
    </div>

    <div class="mb-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-800">My Enrolled Courses</h2>
        <div class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm font-medium">
          <%= length(@courses) %> courses
        </div>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 bg-white rounded-xl shadow-lg overflow-hidden">
          <div class="p-6">
            <%= if @loading do %>
              <div class="flex items-center justify-center py-8">
                <div class="text-center">
                  <.data_loader />
                  <p class="mt-2 text-sm text-gray-600">Loading courses...</p>
                </div>
              </div>
            <% else %>
              <div class="space-y-4">
                <%= for course <- Enum.take(@courses, 6) do %>
              <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg hover:bg-gray-100 transition-colors">
                <div class="flex-1">
                  <h4 class="font-semibold text-gray-800"><%= course.title %></h4>
                  <p class="text-sm text-gray-600 mt-1"><%= course.code %> | <%= course.credits %> credits</p>
                  <div class="mt-2 flex items-center space-x-4 text-xs text-gray-500">
                    <span class="flex items-center">
                      <svg class="w-4 h-4 mr-1 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      Enrolled
                    </span>
                    <span class="flex items-center">
                      <svg class="w-4 h-4 mr-1 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      Active
                    </span>
                  </div>
                </div>
                <div class="ml-4">
                  <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-xs font-medium">Active</span>
                </div>
              </div>
              <% end %>
            </div>

            <%= if length(@courses) == 0 do %>
              <div class="text-center py-8">
                <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
                <h3 class="mt-2 text-sm font-medium text-gray-900">No courses enrolled</h3>
                <p class="mt-1 text-sm text-gray-500">You haven't enrolled in any courses yet.</p>
              </div>
              <% end %>
            <% end %>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl shadow-lg p-6">
          <h3 class="text-lg font-semibold text-gray-800 mb-4">Course Stats</h3>
          <div class="space-y-4">
            <div class="flex items-center justify-between p-3 bg-blue-50 rounded-lg">
              <span class="text-sm font-medium text-blue-800">Total Credits</span>
              <span class="text-lg font-bold text-blue-600">
                <%= Enum.sum(Enum.map(@courses, & &1.credits)) %>
              </span>
            </div>
            <div class="flex items-center justify-between p-3 bg-green-50 rounded-lg">
              <span class="text-sm font-medium text-green-800">Active Courses</span>
              <span class="text-lg font-bold text-green-600"><%= @total_courses %></span>
            </div>
            <div class="flex items-center justify-between p-3 bg-purple-50 rounded-lg">
              <span class="text-sm font-medium text-purple-800">Avg Credits/Course</span>
              <span class="text-lg font-bold text-purple-600">
                <%= if @total_courses > 0 do %>
                <%= Float.round(Enum.sum(Enum.map(@courses, & &1.credits)) / @total_courses, 1) %>
                <% else %>
                0
                <% end %>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mb-8">
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-800">My Recent Activities</h2>
        <div class="bg-orange-100 text-orange-800 px-3 py-1 rounded-full text-sm font-medium">
          Activity feed
        </div>
      </div>
      <div class="bg-white rounded-xl shadow-lg overflow-hidden">
        <div class="p-6">
          <%= if @loading do %>
            <div class="flex items-center justify-center py-8">
              <div class="text-center">
                <.data_loader />
                <p class="mt-2 text-sm text-gray-600">Loading recent activities...</p>
              </div>
            </div>
          <% else %>
            <div class="space-y-4">
            <%= for activity <- Enum.take(@recent_activities, 8) do %>
            <div class="flex items-start space-x-4 p-4 hover:bg-gray-50 rounded-lg transition-colors">
              <div class="flex-shrink-0">
                <div class="bg-green-100 p-2 rounded-lg">
                  <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                </div>
              </div>
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between">
                  <div class="flex-1">
                    <p class="text-sm font-medium text-gray-900">
                      <span class="font-semibold">You marked attendance</span>
                      <span class="text-gray-600 mx-1">for</span>
                      <span class="text-blue-600 font-medium"><%= activity.course_name %></span>
                    </p>
                    <div class="mt-1 flex items-center space-x-2 text-xs text-gray-500">
                      <span><%= activity.module_code %></span>
                      <span>•</span>
                      <span><%= Calendar.strftime(activity.timestamp, "%I:%M %p") %></span>
                      <span>•</span>
                      <span><%= activity.session_date %></span>
                      <span>•</span>
                      <span class="flex items-center">
                        <%= if activity.method == "qr" do %>
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"></path>
                        </svg>
                        QR Code
                        <% else %>
                        <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z"></path>
                        </svg>
                        OTP
                        <% end %>
                      </span>
                    </div>
                  </div>
                  <div class="ml-4 flex-shrink-0">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                      Attendance
                    </span>
                  </div>
                </div>
              </div>
            </div>
            <% end %>
          </div>
          <%= if length(@recent_activities) == 0 do %>
            <div class="text-center py-8">
              <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
              <h3 class="mt-2 text-sm font-medium text-gray-900">No recent activities</h3>
              <p class="mt-1 text-sm text-gray-500">Your attendance activities will appear here.</p>
            </div>
          <% end %>
          <% end %>
          </div>
        </div>
      </div>
    </div>

<div id="student-metrics-data" phx-hook="StudentCharts" data-attendance-labels={Jason.encode!(@attendance_labels || [])} data-attendance-counts={Jason.encode!(@attendance_counts || [])} data-course-labels={Jason.encode!(@course_labels || [])} data-course-counts={Jason.encode!(@course_counts || [])} class="hidden">
</div>

<script>
  // Attendance Trend Chart
  const attendanceTrendCtx = document.getElementById('attendanceTrendChart').getContext('2d');
  const attendanceTrendChart = new Chart(attendanceTrendCtx, {
    type: 'line',
    data: {
      labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
      datasets: [{
        label: 'My Attendance',
        data: [5, 4, 6, 3, 5, 2, 1],
        borderColor: '#3B82F6',
        backgroundColor: 'rgba(59, 130, 246, 0.1)',
        tension: 0.3,
        fill: true
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'top',
        }
      },
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: function(value) {
              return value + ' sessions';
            }
          }
        }
      }
    }
  });

  // Course Distribution Chart
  const courseDistCtx = document.getElementById('courseDistChart').getContext('2d');
  const courseDistChart = new Chart(courseDistCtx, {
    type: 'doughnut',
    data: {
      labels: ['Computer Science', 'Mathematics', 'Physics', 'Literature'],
      datasets: [{
        data: [35, 25, 20, 20],
        backgroundColor: [
          '#3B82F6',
          '#8B5CF6',
          '#10B981',
          '#F59E0B'
        ],
        borderWidth: 1
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'bottom',
        }
      }
    }
  });
</script>