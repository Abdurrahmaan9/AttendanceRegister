<div class="p-6">
  <h1 class="text-2xl font-semibold mb-4">Attendance Overview</h1>

  <%= if @current_user do %>
    <%= if is_nil(@summary) do %>
      <div class="text-gray-600">Loading attendance summary...</div>
    <% else %>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <!-- <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-blue-100 text-sm font-medium">Total Courses</p>
                <h3 class="text-2xl font-bold text-white"><%= @summary.total_courses %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-blue-50">
            <div class="flex items-center justify-between">
              <span class="text-blue-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Active this semester
              </span>
              <span class="text-gray-500 text-xs">current</span>
            </div>
          </div>
        </div> -->   
        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-blue-100 text-sm font-medium">Total Sessions</p>
                <h3 class="text-2xl font-bold text-white"><%= @summary.total_sessions %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-blue-50">
            <div class="flex items-center justify-between">
              <span class="text-blue-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Active this semester
              </span>
              <span class="text-gray-500 text-xs">current</span>
            </div>
          </div>
        </div>        
        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-blue-100 text-sm font-medium">Attended Sessions</p>
                <h3 class="text-2xl font-bold text-white"><%= @summary.attended_sessions %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-green-50">
            <div class="flex items-center justify-between">
              <span class="text-green-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Active this semester
              </span>
              <span class="text-gray-500 text-xs">current</span>
            </div>
          </div>
        </div>        
        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-blue-100 text-sm font-medium">Missed Sessions</p>
                <h3 class="text-2xl font-bold text-white"><%= @summary.missed_sessions %></h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-blue-50">
            <div class="flex items-center justify-between">
              <span class="text-blue-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Active this semester
              </span>
              <span class="text-gray-500 text-xs">current</span>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden">
          <div class="bg-gradient-to-r from-teal-500 to-blue-500 p-4">
            <div class="flex items-center justify-between">
              <div class="bg-white/20 p-3 rounded-lg backdrop-blur">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
                </svg>
              </div>
              <div class="text-right">
                <p class="text-blue-100 text-sm font-medium">Attendance Rate</p>
                <h3 class="text-2xl font-bold text-white"><%= :io_lib.format("~.1f", [@summary.attendance_rate]) |> to_string() %>%</h3>
              </div>
            </div>
          </div>
          <div class="p-4 bg-green-50">
            <div class="flex items-center justify-between">
              <span class="text-green-600 text-sm font-medium flex items-center">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Active this semester
              </span>
              <span class="text-gray-500 text-xs">current</span>
            </div>
          </div>
        </div>  
      </div>
      
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="border-b font-medium">
            <tr>
              <th class="px-3 py-2">Code</th>
              <th class="px-3 py-2">Title</th>
              <th class="px-3 py-2">Attended</th>
              <th class="px-3 py-2">Missed</th>
              <th class="px-3 py-2">Rate</th>
            </tr>
          </thead>
          <tbody class="divide-y">
            <%= for %{course: course, attended: attended, missed: missed, rate: rate} <- @summary.per_course do %>
              <tr>
                <td class="px-3 py-2"><%= course.code %></td>
                <td class="px-3 py-2"><%= course.title %></td>
                <td class="px-3 py-2"><%= attended %></td>
                <td class="px-3 py-2"><%= missed %></td>
                <td class="px-3 py-2"><%= :io_lib.format("~.1f", [rate]) |> to_string() %>%</td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% else %>
    <div class="text-red-600">You must be logged in to view this page.</div>
  <% end %>
</div>