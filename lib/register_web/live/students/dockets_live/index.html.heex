<div class="flex flex-col min-h-screen">
  <div class="flex-1 flex flex-col justify-center items-center px-4 py-12">
    <div class="text-center space-y-6">
      <!-- Welcome Header -->
      <div class="text-black-800 space-y-2">
        <h1 class="text-5xl font-bold">
          Welcome <%= String.upcase(@current_user.first_name <> " " <> @current_user.last_name) %>
        </h1>
        <p class="text-2xl font-semibold text-black-600">
          Student Number: <%= @current_user.email %>
        </p>
      </div>

      <!-- Program Info -->
      <div class="text-black-700">
        <h2 class="text-3xl font-bold text-blue-600">
          <%= @program_name %>
        </h2>
      </div>

      <!-- Instructions -->
      <div class="text-black-600 text-lg">
        <p class="font-semibold">
          Please Choose from the option below the docket you would like to view
        </p>
      </div>

      <!-- Docket Options -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 max-w-4xl">
        <%= for docket <- @docket_types do %>
        <div
          phx-click="select_docket"
          phx-value-type={docket.type}
          class="group cursor-pointer"
        >
          <div class="bg-white rounded-lg shadow-lg p-8 hover:shadow-2xl hover:scale-105 transition-all duration-300 h-full flex flex-col items-center justify-center space-y-4">
            <div class="text-5xl">
              <%= docket.icon %>
            </div>
            <h3 class="text-xl font-bold text-black-800 text-center">
              <%= docket.display %>
            </h3>
            <button
              type="button"
              class="mt-4 px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
            >
              View
            </button>
          </div>
        </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
