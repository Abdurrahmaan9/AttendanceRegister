<div class="p-6">
<h1 class="text-2xl font-semibold mb-4">Program Overview</h1>

<%= if @current_user do %>
   <%= if Enum.empty?(@student_programs) do %>
      <div class="text-gray-600">You are not enrolled in any program yet.</div>
   <% else %>
      <%= if Enum.empty?(@courses) do %>
         <div class="text-gray-600">No courses assigned for your program.</div>
      <% else %>
      <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
         <thead class="border-b font-medium">
            <tr>
            <th class="px-3 py-2">Code</th>
            <th class="px-3 py-2">Title</th>
            <th class="px-3 py-2">Program</th>
            <th class="px-3 py-2">Academic Year</th>
            <th class="px-3 py-2">Year</th>
            <th class="px-3 py-2">Semester</th>
            </tr>
         </thead>
         <tbody class="divide-y">
            <%= for %{course: course, year: year, semester: semester, program: program, academic_year: academic_year} <- @courses do %>
            <tr>
               <td class="px-3 py-2"><%= course.code %></td>
               <td class="px-3 py-2"><%= course.title %></td>
               <td class="px-3 py-2"><%= program.name %></td>
               <td class="px-3 py-2"><%= academic_year %></td>
               <td class="px-3 py-2"><%= year %></td>
               <td class="px-3 py-2"><%= semester %></td>
            </tr>
            <% end %>
         </tbody>
      </table>
      </div>
      <% end %>
   <% end %>
<% else %>
   <div class="text-red-600">You must be logged in to view this page.</div>
<% end %>
</div>