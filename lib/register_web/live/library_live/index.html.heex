<div class="p-6 bg-gray-50 min-h-screen">
  <div class="max-w-7xl mx-auto">
    <!-- Header Tabs -->
    <div class="flex justify-center space-x-8 border-b border-gray-200 mb-6">
      <button
        phx-click="switch_tab"
        phx-value-tab="invited"
        class={"pb-4 text-sm font-medium transition-colors duration-200 " <> if(@active_tab == "invited", do: "text-gray-900 border-b-2 border-gray-900", else: "text-gray-500 hover:text-gray-700")}
      >
        Invited boards
      </button>
      <button
        phx-click="switch_tab"
        phx-value-tab="mine"
        class={"pb-4 text-sm font-medium transition-colors duration-200 " <> if(@active_tab == "mine", do: "text-gray-900 border-b-2 border-gray-900", else: "text-gray-500 hover:text-gray-700")}
      >
        My boards
      </button>
      <button
        phx-click="switch_tab"
        phx-value-tab="liked"
        class={"pb-4 text-sm font-medium transition-colors duration-200 " <> if(@active_tab == "liked", do: "text-gray-900 border-b-2 border-gray-900", else: "text-gray-500 hover:text-gray-700")}
      >
        Liked
      </button>
    </div>

    <!-- Search and Action Bar -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
      <div class="relative flex-1 max-w-lg">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-5 w-5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          name="query"
          value={@search_query}
          phx-keyup="search"
          phx-debounce="300"
          placeholder="Search"
          class="block w-full pl-10 pr-3 py-2 border border-gray-300 rounded-md leading-5 bg-white placeholder-gray-500 focus:outline-none focus:ring-1 focus:ring-teal-500 focus:border-teal-500 sm:text-sm"
        />
      </div>

      <div class="flex items-center space-x-4">
        <div class="flex items-center space-x-2">
          <span class="text-sm text-gray-500">Boards order by</span>
          <select class="text-sm border-gray-300 rounded-md focus:ring-teal-500 focus:border-teal-500">
            <option>Created at</option>
            <option>Name</option>
            <option>Popularity</option>
          </select>
        </div>
        <%= if @active_tab == "mine" and @current_user.role == "admin" do %>
          <.link
            patch={~p"/#{@current_user.role |> String.capitalize()}/library/new_board"}
            class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors"
          >
            Create Board
          </.link>
        <% end %>
        <%= if @current_user.role in ["admin", "lecturer"] do %>
          <.link
            patch={~p"/#{@current_user.role |> String.capitalize()}/library/new"}
            class="bg-teal-600 hover:bg-teal-700 text-white px-4 py-2 rounded-md text-sm font-medium transition-colors"
          >
            Add Resource
          </.link>
        <% end %>
      </div>
    </div>

    <!-- Boards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      <%= for board <- @boards do %>
        <.link
          navigate={~p"/#{String.capitalize(String.replace(@current_user.role, "student", "students"))}/library/boards/#{board.id}"}
          class="group block"
        >
          <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden hover:shadow-md transition-shadow duration-200 group">
            <div class="relative aspect-video bg-gray-100">
              <img
                src={board.cover_image_url || "/images/default-board-cover.jpg"}
                alt={board.title}
                class="w-full h-full object-cover"
              />
              <div class="absolute top-2 right-2 flex space-x-1 opacity-0 group-hover:opacity-100 transition-opacity">
                <button class="p-1 bg-white rounded shadow-sm hover:bg-gray-50">
                  <svg class="h-4 w-4 text-gray-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z" />
                  </svg>
                </button>
              </div>
              <!-- Logo overlay if needed -->
              <div class="absolute inset-0 p-4 flex flex-col justify-between pointer-events-none">
                <div class="text-white font-bold text-xs uppercase tracking-wider">
                  Cavendish University<br/>Zambia
                </div>
              </div>
            </div>
            
            <div class="p-4">
              <h3 class="text-sm font-bold text-gray-900 truncate mb-1" title={board.title}>
                {board.title}
              </h3>
              <p class="text-xs text-gray-500 truncate mb-4">
                {board.subtitle || "Cavendish University Zambia (CUZ)"}
              </p>
              
              <div class="flex items-center text-[10px] text-gray-400 mb-4">
                Created {Calendar.strftime(board.inserted_at, "%d.%m.%Y")}
              </div>
              
              <hr class="mb-4 border-gray-100" />
              
              <div class="flex items-center justify-between text-xs text-gray-400">
                <div class="flex items-center space-x-3">
                  <span class="flex items-center space-x-1">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                    <span>{length(board.resources)}</span>
                  </span>
                  <span class="flex items-center space-x-1">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z" />
                    </svg>
                    <span>{board.views_count}</span>
                  </span>
                  <span class="flex items-center space-x-1">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                    </svg>
                    <span>0</span>
                  </span>
                </div>
                <span class="flex items-center space-x-1">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                  <span>{board.likes_count}</span>
                </span>
              </div>
            </div>
          </div>
        </.link>
      <% end %>
    </div>
  </div>
</div>

<%= if @live_action in [:new, :edit] do %>
  <.modal id="resource-modal" show on_cancel={JS.patch(~p"/#{@current_user.role |> String.capitalize()}/library")}>
    <.live_component
      module={RegisterWeb.LibraryLive.FormComponent}
      id={@board.id || :new}
      title={@page_title}
      action={@live_action}
      board={@board}
      current_user={@current_user}
      patch={~p"/#{@current_user.role |> String.capitalize()}/library"}
    />
  </.modal>
<% end %>

<%= if @live_action == :new_board do %>
  <.modal id="board-modal" show on_cancel={JS.patch(~p"/#{@current_user.role |> String.capitalize()}/library")}>
    <.live_component
      module={RegisterWeb.LibraryLive.BoardFormComponent}
      id={:new_board}
      title={@page_title}
      action={@live_action}
      board={@board}
      current_user={@current_user}
      patch={~p"/#{@current_user.role |> String.capitalize()}/library"}
    />
  </.modal>
<% end %>
